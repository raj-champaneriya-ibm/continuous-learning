                <mxCell id="n_email" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1A1A1A;strokeColor=#3A3A3A;fontColor=#EDEDED;fontFamily=Helvetica;fontSize=13;" value="Customer email" vertex="1">
