    <diagram id="day6-embedding-compat" name="Day 6 · Chat model vs embedding model">
        <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1100" background="#0A0A0A" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <mxCell id="t1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=28;fontStyle=1;fontColor=#F5F5F5;" value="Day 6 · Do the chat model and the embedding model need to be compatible?" vertex="1">
                    <mxGeometry x="40" y="28" width="1360" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="t2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#FBBF24;" value="No. They never exchange vectors. They meet only through plain text." vertex="1">
                    <mxGeometry x="40" y="72" width="1360" height="28" as="geometry"/>
                </mxCell>

                <mxCell id="p1" parent="1" style="rounded=1;arcSize=2;html=1;fillColor=#111111;strokeColor=#262626;" value="" vertex="1">
