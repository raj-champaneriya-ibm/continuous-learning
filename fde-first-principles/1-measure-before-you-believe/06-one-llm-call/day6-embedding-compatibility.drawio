                </mxCell>
                <mxCell id="p1t" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontStyle=1;fontColor=#F5F5F5;" value="1 · How the two models connect" vertex="1">
                    <mxGeometry x="60" y="138" width="600" height="28" as="geometry"/>
                </mxCell>

                <mxCell id="zv" parent="1" style="rounded=1;arcSize=3;html=1;fillColor=none;strokeColor=#3F3F3F;dashed=1;dashPattern=4 4;" value="" vertex="1">
