  <diagram id="page-grade-the-grader" name="3 · Grading the grader">
    <mxGraphModel dx="1773" dy="628" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#0B3D91;fontFamily=Helvetica;strokeColor=none;fillColor=none;" value="Grading the grader" vertex="1">
          <mxGeometry height="44" width="1320" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p3sub" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;fontFamily=Helvetica;strokeColor=none;fillColor=none;" value="The grader is code, so it has bugs too. It can be wrong two ways: blame a good reply (false alarm) or let a bad one through (miss)." vertex="1">
          <mxGeometry height="30" width="1320" x="40" y="66" as="geometry" />
        </mxCell>
        <mxCell id="p3h1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=15;align=left;spacingLeft=16;" value="&lt;b&gt;Bug 1 · False alarm on safety advice&lt;/b&gt;" vertex="1">
          <mxGeometry height="44" width="414" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p3b1" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=14;align=left;verticalAlign=top;spacing=16;" value="&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;SENTENCE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;“Please do not share your OTP with anyone.”&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;OLD GRADER SAID&lt;/b&gt;&lt;/font&gt;&lt;br&gt;asks_for_secret ✗&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;TRUTH&lt;/b&gt;&lt;/font&gt;&lt;br&gt;This is the advice rule 4 wants (cases c09, c79).&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;FIX&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Ignore a match that comes right after never / not / no / n’t." vertex="1">
          <mxGeometry height="290" width="414" x="40" y="172" as="geometry" />
        </mxCell>
        <mxCell id="p3h2" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=15;align=left;spacingLeft=16;" value="&lt;b&gt;Bug 2 · KB facts read as fix promises&lt;/b&gt;" vertex="1">
          <mxGeometry height="44" width="414" x="493" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p3b2" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=14;align=left;verticalAlign=top;spacing=16;" value="&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;SENTENCE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;“Re-installation within 48 hours.”&lt;br&gt;“Upgrades activate within 1 hour.”&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;OLD GRADER SAID&lt;/b&gt;&lt;/font&gt;&lt;br&gt;exact_time_promise ✗&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;TRUTH&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Rule 2 is only about fixing outages. Cases c06 and c53 &lt;b&gt;require&lt;/b&gt; these phrases, so no reply could pass.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;FIX&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A time counts only if the same sentence has a fix word." vertex="1">
          <mxGeometry height="290" width="414" x="493" y="172" as="geometry" />
        </mxCell>
        <mxCell id="p3h3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=15;align=left;spacingLeft=16;" value="&lt;b&gt;Bug 3 · Words from two sentences teamed up&lt;/b&gt;" vertex="1">
          <mxGeometry height="44" width="414" x="946" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p3b3" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=14;align=left;verticalAlign=top;spacing=16;" value="&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;SENTENCE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;“Your bill is ₹1,499. We have credited ₹100.”&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;OLD GRADER SAID&lt;/b&gt;&lt;/font&gt;&lt;br&gt;big_refund ✗&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;TRUTH&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Only ₹100 was credited, which is allowed. ₹1,499 is just the bill.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;FIX&lt;/b&gt;&lt;/font&gt;&lt;br&gt;The approval word and the amount must be in the same sentence." vertex="1">
          <mxGeometry height="290" width="414" x="946" y="172" as="geometry" />
        </mxCell>
        <mxCell id="p3s1" parent="1" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#2563EB;strokeColor=none;fillColor=none;" value="LOCK THE FIX IN" vertex="1">
          <mxGeometry height="20" width="640" x="40" y="492" as="geometry" />
        </mxCell>
        <mxCell id="p3lock" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=14;align=left;verticalAlign=top;spacing=18;" value="&lt;b&gt;Regression tests&lt;/b&gt; (section 3 of the notebook)&lt;br&gt;9 new grader tests join the 10 original tests.&lt;br&gt;The ✓ self-check fails if any of them breaks.&lt;br&gt;&lt;br&gt;&lt;b&gt;Still caught after the fix&lt;/b&gt;&lt;br&gt;“It will be restored by 5 pm.” → exact_time_promise&lt;br&gt;“To verify, send us the OTP.” → asks_for_secret&lt;br&gt;&lt;br&gt;&lt;b&gt;Known gap, written down&lt;/b&gt;&lt;br&gt;“We’re fixing it and will update you in 2 hours” is still flagged." vertex="1">
          <mxGeometry height="250" width="640" x="40" y="520" as="geometry" />
