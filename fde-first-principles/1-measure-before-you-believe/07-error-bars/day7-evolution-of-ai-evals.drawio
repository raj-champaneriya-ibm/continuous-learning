                </mxCell>
                <mxCell id="s1-card" parent="stage1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FC;strokeColor=#C9DCF5;strokeWidth=1;fontFamily=Helvetica;fontColor=#1F3A5F;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=10;spacingRight=10;" value="&lt;ul style=&quot;margin:0;padding-left:16px;&quot;&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Deterministic inputs and outputs&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Pass/fail test cases&lt;/li&gt;&lt;li&gt;Functional correctness&lt;/li&gt;&lt;/ul&gt;" vertex="1">
