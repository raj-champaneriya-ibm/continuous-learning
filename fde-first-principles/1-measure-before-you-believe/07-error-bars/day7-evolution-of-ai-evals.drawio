                <mxCell id="s5-title" parent="stage5" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#0B2545;" value="System-level evaluation" vertex="1">
                    <mxGeometry x="0" y="44" width="214" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="s5-question" parent="stage5" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#2E6FD8;" value="“Does the whole system work?”" vertex="1">
                    <mxGeometry x="0" y="92" width="214" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="s5-card" parent="stage5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FC;strokeColor=#C9DCF5;strokeWidth=1;fontFamily=Helvetica;fontColor=#1F3A5F;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=10;spacingRight=10;" value="&lt;ul style=&quot;margin:0;padding-left:16px;&quot;&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Model, prompt, retrieval, tools, and orchestration&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;End-to-end task success&lt;/li&gt;&lt;li&gt;Latency, cost, reliability, and failure modes&lt;/li&gt;&lt;/ul&gt;" vertex="1">
                    <mxGeometry x="0" y="136" width="214" height="210" as="geometry"/>
                </mxCell>

                <!-- Stage 6 (turning point) -->
                <mxCell id="stage6" parent="1" style="group" vertex="1" connectable="0">
                    <mxGeometry x="1380" y="180" width="214" height="346" as="geometry"/>
                </mxCell>
                <mxCell id="s6-marker" parent="stage6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F59E0B;strokeColor=none;fontColor=#0B2545;fontSize=15;fontStyle=1;fontFamily=Helvetica;" value="6" vertex="1">
                    <mxGeometry x="89" y="0" width="36" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="s6-title" parent="stage6" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#0B2545;" value="Agentic AI evaluation" vertex="1">
                    <mxGeometry x="0" y="44" width="214" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="s6-question" parent="stage6" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#2E6FD8;" value="“Does the agent finish the job?”" vertex="1">
                    <mxGeometry x="0" y="92" width="214" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="s6-card" parent="stage6" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FC;strokeColor=#F59E0B;strokeWidth=2;fontFamily=Helvetica;fontColor=#1F3A5F;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=10;spacingRight=10;" value="&lt;div style=&quot;color:#B45309;font-weight:bold;font-size:11px;margin-bottom:8px;&quot;&gt;TURNING POINT · The AI acts, not just answers&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:16px;&quot;&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Multi-step task completion&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Tool-use correctness&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Planning and recovery&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;State management&lt;/li&gt;&lt;li&gt;Human intervention and escalation&lt;/li&gt;&lt;/ul&gt;" vertex="1">
                    <mxGeometry x="0" y="136" width="214" height="210" as="geometry"/>
                </mxCell>

