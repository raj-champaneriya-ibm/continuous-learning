                </mxCell>
                <mxCell id="s3-marker" parent="stage3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F59E0B;strokeColor=none;fontColor=#0B2545;fontSize=15;fontStyle=1;fontFamily=Helvetica;" value="3" vertex="1">
                    <mxGeometry x="89" y="0" width="36" height="36" as="geometry"/>
