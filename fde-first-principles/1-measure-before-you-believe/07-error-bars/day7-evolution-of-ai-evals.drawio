                <mxCell id="s7-marker" parent="stage7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E6FD8;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;fontFamily=Helvetica;" value="7" vertex="1">
