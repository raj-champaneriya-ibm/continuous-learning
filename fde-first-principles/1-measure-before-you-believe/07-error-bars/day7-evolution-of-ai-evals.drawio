                </mxCell>
                <mxCell id="sec-learned" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#2E6FD8;" value="WHAT WE LEARNED" vertex="1">
