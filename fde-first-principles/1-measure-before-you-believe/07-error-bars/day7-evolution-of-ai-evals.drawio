                </mxCell>
                <mxCell id="s1-marker" parent="stage1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E6FD8;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;fontFamily=Helvetica;" value="1" vertex="1">
