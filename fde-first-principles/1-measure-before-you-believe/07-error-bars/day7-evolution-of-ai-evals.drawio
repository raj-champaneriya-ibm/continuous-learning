                <!-- What we learned: one lesson per transition -->
                <mxCell id="lesson12" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6FD8;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#0B2545;fontSize=14;align=center;verticalAlign=middle;spacing=10;" value="&lt;font style=&quot;font-size:11px;&quot; color=&quot;#2E6FD8&quot;&gt;&lt;b&gt;STAGE 1 → 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A single score hides important variation" vertex="1">
                    <mxGeometry x="184" y="610" width="230" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="lesson23" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6FD8;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#0B2545;fontSize=14;align=center;verticalAlign=middle;spacing=10;" value="&lt;font style=&quot;font-size:11px;&quot; color=&quot;#2E6FD8&quot;&gt;&lt;b&gt;STAGE 2 → 3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Evaluation datasets must represent real user tasks" vertex="1">
                    <mxGeometry x="448" y="610" width="230" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="lesson34" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6FD8;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#0B2545;fontSize=14;align=center;verticalAlign=middle;spacing=10;" value="&lt;font style=&quot;font-size:11px;&quot; color=&quot;#2E6FD8&quot;&gt;&lt;b&gt;STAGE 3 → 4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Repeated measurements are necessary for probabilistic systems" vertex="1">
                    <mxGeometry x="712" y="610" width="230" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="lesson45" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6FD8;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#0B2545;fontSize=14;align=center;verticalAlign=middle;spacing=10;" value="&lt;font style=&quot;font-size:11px;&quot; color=&quot;#2E6FD8&quot;&gt;&lt;b&gt;STAGE 4 → 5&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Benchmark performance does not guarantee production success" vertex="1">
                    <mxGeometry x="976" y="610" width="230" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="lesson56" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6FD8;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#0B2545;fontSize=14;align=center;verticalAlign=middle;spacing=10;" value="&lt;font style=&quot;font-size:11px;&quot; color=&quot;#2E6FD8&quot;&gt;&lt;b&gt;STAGE 5 → 6&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Component evaluation alone cannot validate an entire AI system" vertex="1">
                    <mxGeometry x="1240" y="610" width="230" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="lesson67" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6FD8;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#0B2545;fontSize=14;align=center;verticalAlign=middle;spacing=10;" value="&lt;font style=&quot;font-size:11px;&quot; color=&quot;#2E6FD8&quot;&gt;&lt;b&gt;STAGE 6 → 7&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Evaluation must continue after deployment" vertex="1">
                    <mxGeometry x="1504" y="610" width="230" height="84" as="geometry"/>
                </mxCell>

                <!-- Dashed links: each lesson to the two stages it bridges (vertical, non-crossing) -->
                <mxCell id="l12a" parent="1" source="s1-card" target="lesson12" edge="1" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#8DB3EC;strokeWidth=1.5;exitX=0.79;exitY=1;exitDx=0;exitDy=0;entryX=0.196;entryY=0;entryDx=0;entryDy=0;">
