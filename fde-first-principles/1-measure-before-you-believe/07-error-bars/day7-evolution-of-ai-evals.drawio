                <mxCell id="s7-question" parent="stage7" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#2E6FD8;" value="“Is it still working for users?”" vertex="1">
                    <mxGeometry x="0" y="92" width="214" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="s7-card" parent="stage7" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FC;strokeColor=#C9DCF5;strokeWidth=1;fontFamily=Helvetica;fontColor=#1F3A5F;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=10;spacingRight=10;" value="&lt;ul style=&quot;margin:0;padding-left:16px;&quot;&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Online monitoring&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Real-user feedback&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Regression detection&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Red-team testing&lt;/li&gt;&lt;li&gt;Evaluation-driven improvement loops&lt;/li&gt;&lt;/ul&gt;" vertex="1">
