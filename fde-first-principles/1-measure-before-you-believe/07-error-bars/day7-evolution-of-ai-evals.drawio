                <mxCell id="s3-title" parent="stage3" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#0B2545;" value="Foundation model evaluation" vertex="1">
                    <mxGeometry x="0" y="44" width="214" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="s3-question" parent="stage3" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#2E6FD8;" value="“Is it good, safe, and grounded?”" vertex="1">
                    <mxGeometry x="0" y="92" width="214" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="s3-card" parent="stage3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FC;strokeColor=#F59E0B;strokeWidth=2;fontFamily=Helvetica;fontColor=#1F3A5F;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=10;spacingRight=10;" value="&lt;div style=&quot;color:#B45309;font-weight:bold;font-size:11px;margin-bottom:8px;&quot;&gt;TURNING POINT · Outputs become open-ended&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:16px;&quot;&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Benchmarks and human preference&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Prompt sensitivity&lt;/li&gt;&lt;li&gt;Quality, safety, bias, and groundedness&lt;/li&gt;&lt;/ul&gt;" vertex="1">
                    <mxGeometry x="0" y="136" width="214" height="210" as="geometry"/>
                </mxCell>

                <!-- Stage 4 (turning point) -->
                <mxCell id="stage4" parent="1" style="group" vertex="1" connectable="0">
                    <mxGeometry x="852" y="180" width="214" height="346" as="geometry"/>
                </mxCell>
                <mxCell id="s4-marker" parent="stage4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F59E0B;strokeColor=none;fontColor=#0B2545;fontSize=15;fontStyle=1;fontFamily=Helvetica;" value="4" vertex="1">
                    <mxGeometry x="89" y="0" width="36" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="s4-title" parent="stage4" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#0B2545;" value="Statistical evaluation" vertex="1">
                    <mxGeometry x="0" y="44" width="214" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="s4-question" parent="stage4" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#2E6FD8;" value="“How sure are we?”" vertex="1">
                    <mxGeometry x="0" y="92" width="214" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="s4-card" parent="stage4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FC;strokeColor=#F59E0B;strokeWidth=2;fontFamily=Helvetica;fontColor=#1F3A5F;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=10;spacingRight=10;" value="&lt;div style=&quot;color:#B45309;font-weight:bold;font-size:11px;margin-bottom:8px;&quot;&gt;TURNING POINT · One run is not evidence&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:16px;&quot;&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Repeated trials&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Confidence intervals&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Variance and uncertainty&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px;&quot;&gt;Sample-size awareness&lt;/li&gt;&lt;li&gt;Pairwise and comparative analysis&lt;/li&gt;&lt;/ul&gt;" vertex="1">
                    <mxGeometry x="0" y="136" width="214" height="210" as="geometry"/>
                </mxCell>

                <!-- Stage 5 -->
                <mxCell id="stage5" parent="1" style="group" vertex="1" connectable="0">
                    <mxGeometry x="1116" y="180" width="214" height="346" as="geometry"/>
                </mxCell>
                <mxCell id="s5-marker" parent="stage5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E6FD8;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;fontFamily=Helvetica;" value="5" vertex="1">
