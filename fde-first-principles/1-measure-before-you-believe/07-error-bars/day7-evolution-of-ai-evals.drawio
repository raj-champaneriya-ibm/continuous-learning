                <!-- Header -->
                <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontStyle=1;fontColor=#0B2545;" value="Evolution of AI Evaluations" vertex="1">
                    <mxGeometry x="60" y="36" width="1300" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#1F3A5F;" value="Evaluation shifted from &lt;b&gt;“Does it pass?”&lt;/b&gt; to &lt;b&gt;“How confident are we, and how do we know?”&lt;/b&gt; FDEs think in evidence, not verdicts." vertex="1">
                    <mxGeometry x="60" y="86" width="1500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="read-hint" parent="1" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5B7DB1;" value="Read left → right, then down" vertex="1">
                    <mxGeometry x="1560" y="46" width="300" height="26" as="geometry"/>
                </mxCell>

                <!-- Section labels -->
