<mxfile host="app.diagrams.net">
    <diagram id="evolution-of-ai-evaluations" name="Evolution of AI Evaluations">
        <mxGraphModel dx="1920" dy="1080" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#F7FAFF" math="0" shadow="0">
