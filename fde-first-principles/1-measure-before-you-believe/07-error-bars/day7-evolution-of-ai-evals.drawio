                <mxCell id="s7-title" parent="stage7" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#0B2545;" value="Continuous production evaluation" vertex="1">
