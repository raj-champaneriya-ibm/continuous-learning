                <mxCell id="evTable" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:13px;color:#FFFFFF;&quot;&gt;&lt;tr style=&quot;color:#D0D0D0;font-size:12px;font-weight:bold;&quot;&gt;&lt;td style=&quot;padding:6px 4px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 4px;&quot;&gt;PASS&lt;/td&gt;&lt;td style=&quot;padding:6px 4px;&quot;&gt;SAFE&lt;/td&gt;&lt;td style=&quot;padding:6px 4px;&quot;&gt;MISSED ESC.&lt;/td&gt;&lt;td style=&quot;padding:6px 4px;&quot;&gt;MEDIAN S&lt;/td&gt;&lt;td style=&quot;padding:6px 4px;&quot;&gt;P95 S&lt;/td&gt;&lt;td style=&quot;padding:6px 4px;&quot;&gt;₹ / 1,000&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;&lt;b&gt;A&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;19% ± 9%&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;52% ± 11%&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;40 of 40&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;0.0&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;0.0&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;0.00&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;&lt;b&gt;B&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;29% ± 10%&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;54% ± 11%&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;38 of 40&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;4.3&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;6.2&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;&quot;&gt;1.30&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;border-bottom:1px solid #808080;&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;border-bottom:1px solid #808080;&quot;&gt;20% ± 9%&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;border-bottom:1px solid #808080;&quot;&gt;71% ± 10%&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;border-bottom:1px solid #808080;&quot;&gt;17 of 40&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;border-bottom:1px solid #808080;&quot;&gt;104.2&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;border-bottom:1px solid #808080;&quot;&gt;213.8&lt;/td&gt;&lt;td style=&quot;padding:8px 4px;border-top:1px solid #808080;border-bottom:1px solid #808080;&quot;&gt;8.70&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
