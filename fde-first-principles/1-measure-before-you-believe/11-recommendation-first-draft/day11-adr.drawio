                <!-- Bottom row -->
                <mxCell id="gPanel" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FFFFFF;strokeWidth=1.5;" value="" vertex="1">
