                <mxCell id="gLabel" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#D0D0D0;" value="05 · GATES BEFORE UNREVIEWED REPLIES" vertex="1">
                    <mxGeometry height="20" width="310" x="60" y="806" as="geometry"/>
                </mxCell>
                <mxCell id="gBody" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#EDEDED;" value="Measured once on held-out cases:&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;0&lt;/b&gt;&lt;/font&gt; policy breaks&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;≤ 2 of 40&lt;/b&gt;&lt;/font&gt; missed escalations&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;&amp;gt; 19%&lt;/b&gt;&lt;/font&gt; pass-rate lower bound (beats A)" vertex="1">
                    <mxGeometry height="230" width="310" x="60" y="836" as="geometry"/>
                </mxCell>

                <mxCell id="cPanel" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#808080;strokeWidth=1;" value="" vertex="1">
                    <mxGeometry height="290" width="350" x="430" y="790" as="geometry"/>
                </mxCell>
                <mxCell id="cLabel" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#D0D0D0;" value="06 · CONSEQUENCES" vertex="1">
                    <mxGeometry height="20" width="310" x="450" y="806" as="geometry"/>
                </mxCell>
                <mxCell id="cBody" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#EDEDED;" value="&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Good&lt;/b&gt;&lt;/font&gt; · escalation is its own step, measured and fixed alone. One or two calls per email. The policy check is code, not hope.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Bad&lt;/b&gt;&lt;/font&gt; · more emails reach people at first. Searched context will lower B's numbers by an unmeasured amount.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Risks&lt;/b&gt;&lt;/font&gt; · the router is the single point of failure. The grader has known false alarms. B and C runs lack prompt fingerprints." vertex="1">
                    <mxGeometry height="230" width="310" x="450" y="836" as="geometry"/>
                </mxCell>

                <mxCell id="mPanel" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#808080;strokeWidth=1;" value="" vertex="1">
                    <mxGeometry height="290" width="350" x="820" y="790" as="geometry"/>
                </mxCell>
                <mxCell id="mLabel" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#D0D0D0;" value="07 · WHAT WOULD CHANGE MY MIND" vertex="1">
                    <mxGeometry height="20" width="310" x="840" y="806" as="geometry"/>
                </mxCell>
                <mxCell id="mBody" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#EDEDED;" value="&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Router misses more than 2 of 40&lt;/b&gt;&lt;/font&gt;&lt;br&gt;→ do not automate replies: A's templates plus human triage.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;C on a stronger model passes the gates, p95 under 60 s&lt;/b&gt;&lt;/font&gt;&lt;br&gt;→ the agent earns its complexity.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Searched context costs B more than 10 points of facts&lt;/b&gt;&lt;/font&gt;&lt;br&gt;→ retrieval comes first, before any rollout." vertex="1">
                    <mxGeometry height="230" width="310" x="840" y="836" as="geometry"/>
                </mxCell>

                <mxCell id="qPanel" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#808080;strokeWidth=1;" value="" vertex="1">
