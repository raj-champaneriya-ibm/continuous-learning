-2" value="&lt;span style=&quot;font-size:12px;color:#3E6489&quot;&gt;an outage comes up only when the customer reports one, in any language&lt;/span&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1268" y="714" width="248" height="40" as="geometry" /></mxCell><mxCell id="p2-out-3" value="&lt;span style=&quot;font-size:11px;color:#2C7BBF&quot;&gt;&lt;b&gt;unasked outages 8 → 0&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3F1FB;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1524" y="719" width="148" height="28" as="geometry" /></mxCell><mxCell id="p2-73" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#B9D7EE;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1060" y="768" width="620" height="54" as="geometry" /></mxCell><mxCell id="p2-74" value="&lt;b&gt;Owners and lifecycle&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#173A5E;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1074" y="776" width="190" height="40" as="geometry" /></mxCell><mxCell id="p2-75" value="&lt;span style=&quot;font-size:12px;color:#3E6489&quot;&gt;every concept says who changes it, and if it is live&lt;/span&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1268" y="776" width="248" height="40" as="geometry" /></mxCell><mxCell id="p2-76" value="&lt;span style=&quot;font-size:11px;color:#2C7BBF&quot;&gt;&lt;b&gt;safe to change&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3F1FB;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1524" y="781" width="148" height="28" as="geometry" /></mxCell><mxCell id="p2-77" value="What the model actually sees (the C4 envelope, abridged)" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=17;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="900" height="24" as="geometry" /></mxCell><mxCell id="p2-78" value="&lt;span style=&quot;font-family:Courier New;font-size:12px;color:#173A5E&quot;&gt;Remaining 30-day concession headroom: ₹500&lt;br&gt;Offer decisions (eligible is not approved; follow these):&lt;br&gt;- late-fee waiver (KB02): OFFER. Eligible, and ₹100 fits the ₹500 headroom.&lt;br&gt;- retention offer (KB11): OFFER. Eligible and pre-approved: ₹750 doesn't count toward the limit (policy 13).&lt;br&gt;- double payment refund (KB04): AUTOMATIC. Eligible: duplicate payment of ₹1499 on record; …&lt;br&gt;Ontology-linked KB articles: KB11&lt;br&gt;Grounded KB excerpts: KB11 · Retention offer: Customers with more than 12 months of tenure who ask to cancel can be offered 50% off for 1 month. The offer is pre-approved on every plan, …&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5FAFE;strokeColor=#B9D7EE;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="914" width="960" height="136" as="geometry" /></mxCell><mxCell id="p2-79" value="&lt;b&gt;The split that makes it work&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#3E6489&quot;&gt;The &lt;b&gt;graph&lt;/b&gt; answers &lt;i&gt;what is true and allowed&lt;/i&gt;. The &lt;b&gt;model&lt;/b&gt; answers &lt;i&gt;how to say it&lt;/i&gt;. The &lt;b&gt;checks&lt;/b&gt; make sure the two agree before anything is sent.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#7A97B3&quot;&gt;Every escalation records its reason: rule, tool, model, guard or offer.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3F1FB;strokeColor=#8EC1E6;strokeWidth=1;fontSize=16;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1060" y="914" width="620" height="136" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>