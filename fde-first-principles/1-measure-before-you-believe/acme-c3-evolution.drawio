&lt;/b&gt;/40 · over &lt;b&gt;4&lt;/b&gt;&lt;/span&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="2294" y="422" width="212" height="28" as="geometry" /></mxCell><mxCell id="p1-135" value="" style="html=1;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;strokeColor=#2C7BBF;strokeWidth=1.4;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-3" target="p1-25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-136" value="" style="html=1;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;strokeColor=#2C7BBF;strokeWidth=1.4;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-25" target="p1-47"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-137" value="" style="html=1;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;strokeColor=#2C7BBF;strokeWidth=1.4;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-47" target="p1-69"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-138" value="" style="html=1;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;strokeColor=#2C7BBF;strokeWidth=1.4;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-69" target="p1-91"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-139" value="" style="html=1;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;strokeColor=#2C7BBF;strokeWidth=1.4;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-91" target="p1-113"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e6" value="" style="html=1;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;strokeColor=#2C7BBF;strokeWidth=1.4;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-113" target="p1-c6-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e7" value="" style="html=1;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;strokeColor=#2C7BBF;strokeWidth=1.4;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-c6-0" target="p1-c7-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-e8" value="" style="html=1;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;strokeColor=#2C7BBF;strokeWidth=1.4;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-c7-0" target="p1-c8-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-140" value="&lt;b&gt;How to read a card&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#3E6489&quot;&gt;&lt;b&gt;Intent&lt;/b&gt; the right category · &lt;b&gt;Facts&lt;/b&gt; the reply contains what it must · &lt;b&gt;Policy&lt;/b&gt; no rule broken · &lt;b&gt;Human&lt;/b&gt; the right call on escalating.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#3E6489&quot;&gt;B looks strong because its articles were handed in from the right answer. C had to find them itself with a 4B model, and facts fell to 35%.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#B9D7EE;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="640" height="116" as="geometry" /></mxCell><mxCell id="p1-141" value="&lt;span style=&quot;font-size:11px;color:#7A97B3&quot;&gt;C → C2&lt;/span&gt;&lt;br&gt;&lt;b&gt;The model sets the ceiling&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#3E6489&quot;&gt;Same loop, stronger model: pass 19% → 48%, missed escalations 17 → 7.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="735.0" y="500" width="250" height="116" as="geometry" /></mxCell><mxCell id="p1-142" value="" style="shape=ellipse;perimeter=ellipsePerimeter;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#2C7BBF;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="857.0" y="140" width="6" height="6" as="geometry" /></mxCell><mxCell id="p1-143" value="" style="html=1;fontFamily=Helvetica;endArrow=none;endFill=1;endSize=7;strokeColor=#7A97B3;strokeWidth=1;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-141" target="p1-142"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-144" value="&lt;span style=&quot;font-size:11px;color:#7A97B3&quot;&gt;C2 → C3&lt;/span&gt;&lt;br&gt;&lt;b&gt;Ground it in a graph&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#3E6489&quot;&gt;Same model. Facts 82.1 → 91.7, missed escalations 7 → 1.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1015.0" y="500" width="250" height="116" as="geometry" /></mxCell><mxCell id="p1-145" value="" style="shape=ellipse;perimeter=ellipsePerimeter;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#2C7BBF;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1137.0" y="140" width="6" height="6" as="geometry" /></mxCell><mxCell id="p1-146" value="" style="html=1;fontFamily=Helvetica;endArrow=none;endFill=1;endSize=7;strokeColor=#7A97B3;strokeWidth=1;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-144" target="p1-145"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-147" value="&lt;span style=&quot;font-size:11px;color:#7A97B3&quot;&gt;C3 → C3 v2&lt;/span&gt;&lt;br&gt;&lt;b&gt;Rules as code&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#3E6489&quot;&gt;Today's checks find 10 Hinglish replies and 11 unasked outages in C3. v2 moves escalation and offer rules into code: pass 51%* → 86%*.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1295.0" y="500" width="250" height="116" as="geometry" /></mxCell><mxCell id="p1-148" value="" style="shape=ellipse;perimeter=ellipsePerimeter;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#2C7BBF;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1417.0" y="140" width="6" height="6" as="geometry" /></mxCell><mxCell id="p1-149" value="" style="html=1;fontFamily=Helvetica;endArrow=none;endFill=1;endSize=7;strokeColor=#7A97B3;strokeWidth=1;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-147" target="p1-148"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-n1-box" value="&lt;span style=&quot;font-size:11px;color:#7A97B3&quot;&gt;C3 v2 → C3 v3&lt;/span&gt;&lt;br&gt;&lt;b&gt;A stricter grader, a lower score&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#3E6489&quot;&gt;Round-2 checks flag 10 v3 replies that quote the ₹500 limit or raise an outage nobody asked about: 86.9% on its day, 81.0% today.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1575" y="500" width="250" height="116" as="geometry" /></mxCell><mxCell id="p1-n1-dot" value="" style="shape=ellipse;perimeter=ellipsePerimeter;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#2C7BBF;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1697" y="140" width="6" height="6" as="geometry" /></mxCell><mxCell id="p1-n1-line" value="" style="html=1;fontFamily=Helvetica;endArrow=none;endFill=1;endSize=7;strokeColor=#7A97B3;strokeWidth=1;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-n1-box" target="p1-n1-dot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-n2-box" value="&lt;span style=&quot;font-size:11px;color:#7A97B3&quot;&gt;C3 v3 → C3 v4&lt;/span&gt;&lt;br&gt;&lt;b&gt;The expert's rules, in the graph&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#3E6489&quot;&gt;Outage concept + gate, limit never quoted, retention offer pre-approved (policy 13): pass 81.0% → 92.9%, zero policy breaks.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1855" y="500" width="250" height="116" as="geometry" /></mxCell><mxCell id="p1-n2-dot" value="" style="shape=ellipse;perimeter=ellipsePerimeter;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#2C7BBF;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1977" y="140" width="6" height="6" as="geometry" /></mxCell><mxCell id="p1-n2-line" value="" style="html=1;fontFamily=Helvetica;endArrow=none;endFill=1;endSize=7;strokeColor=#7A97B3;strokeWidth=1;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-n2-box" target="p1-n2-dot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-n3-box" value="&lt;span style=&quot;font-size:11px;color:#7A97B3&quot;&gt;C3 v4 → C4&lt;/span&gt;&lt;br&gt;&lt;b&gt;Same score, different failures&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#3E6489&quot;&gt;KB excerpts + a forced final draft won back c13, c15, c47, c73 but lost c22, c24, c25, c65, c79: 92.9% → 91.7%, one email, inside ±6 points.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="2135" y="500" width="250" height="116" as="geometry" /></mxCell><mxCell id="p1-n3-dot" value="" style="shape=ellipse;perimeter=ellipsePerimeter;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#2C7BBF;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="2257" y="140" width="6" height="6" as="geometry" /></mxCell><mxCell id="p1-n3-line" value="" style="html=1;fontFamily=Helvetica;endArrow=none;endFill=1;endSize=7;strokeColor=#7A97B3;strokeWidth=1;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-n3-box" target="p1-n3-dot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1-b-title" value="C4 beyond the 84: the first run on all 256 test emails" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=17;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="1600" height="28" as="geometry" /></mxCell><mxCell id="p1-b-sub" value="Same grader. &lt;b&gt;Abuse&lt;/b&gt;: 40 pairs, a customer milking a loophole and one who is entitled, told apart by the record. &lt;b&gt;Multi-turn&lt;/b&gt;: graded on the next reply. &lt;b&gt;Regional&lt;/b&gt;: Marathi, Hindi, Tamil and 6 more languages or mixes." style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#3E6489;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="688" width="2480" height="22" as="geometry" /></mxCell><mxCell id="p1-b0-tile" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5FAFE;strokeColor=#B9D7EE;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="722" width="230" height="104" as="geometry" /></mxCell><mxCell id="p1-b0-head" value="&lt;span style=&quot;font-size:12px;color:#173A5E&quot;&gt;&lt;b&gt;Base&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size:11px;color:#7A97B3&quot;&gt; · 84 emails&lt;/span&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="54" y="730" width="200" height="18" as="geometry" /></mxCell><mxCell id="p1-b0-pass" value="&lt;span style=&quot;font-size:20px;color:#2C7BBF&quot;&gt;&lt;b&gt;91.7%&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size:11px;color:#3E6489&quot;&gt;&amp;nbsp; pas