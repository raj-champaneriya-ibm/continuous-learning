ive="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-138" value="" style="html=1;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;strokeColor=#2C7BBF;strokeWidth=1.4;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-69" target="p1-91"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-139" value="" style="html=1;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;strokeColor=#2C7BBF;strokeWidth=1.4;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.08;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-91" target="p1-113"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-140" value='&lt;b&gt;How to read a card&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3E6489"&gt;&lt;b&gt;Intent&lt;/b&gt; the right category · &lt;b&gt;Facts&lt;/b&gt; the reply contains what it must · &lt;b&gt;Policy&lt;/b&gt; no rule broken · &lt;b&gt;Human&lt;/b&gt; the right call on escalating.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3E6489"&gt;B looks strong because its articles were handed in from the right answer. C had to find them itself with a 4B model, and facts fell to 36%.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#B9D7EE;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="640" height="116" as="geometry"/></mxCell><mxCell id="p1-141" value='&lt;span style="font-size:11px;color:#7A97B3"&gt;C → C2&lt;/span&gt;&lt;br&gt;&lt;b&gt;The model sets the ceiling&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3E6489"&gt;Same loop, stronger model: pass 20% → 63%.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="735.0" y="500" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-142" value="" style="shape=ellipse;perimeter=ellipsePerimeter;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#2C7BBF;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="857.0" y="140" width="6" height="6" as="geometry"/></mxCell><mxCell id="p1-143" value="" style="html=1;fontFamily=Helvetica;endArrow=none;endFill=1;endSize=7;strokeColor=#7A97B3;strokeWidth=1;fontSize=11;fontColor=#3E6489;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=none;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-141" target="p1-142"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-144" value='&lt;span style="font-size:11px;color:#7A97B3"&gt;C2 → C3&lt;/span&gt;&lt;br&gt;&lt;b&gt;Ground it in a graph&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3E6489"&gt;Same model. Facts 84.5 → 94.0, missed escalations 7 → 1.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1015.0" y="500" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-145" value="" style="shape=ellipse;perimeter=ellipsePerimeter;rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#2C7BBF;strokeColor=n