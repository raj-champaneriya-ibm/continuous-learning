x="40" y="356" width="900" height="24" as="geometry" /></mxCell><mxCell id="p2-26" value="&lt;span style=&quot;font-size:12px;color:#3E6489&quot;&gt;Customer AC1009 (Pro plan, 30 months) writes: “Close my connection unless you give me the loyalty discount.”&lt;/span&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="960" height="20" as="geometry" /></mxCell><mxCell id="p2-27" value="&lt;span style=&quot;font-size:12px;color:#173A5E&quot;&gt;“loyalty discount”&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#B9D7EE;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="432" width="140" height="44" as="geometry" /></mxCell><mxCell id="p2-28" value="&lt;b&gt;Retention offer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#3E6489&quot;&gt;tenure ≥ 13 · once a year&lt;br&gt;countsToward: false&lt;/span&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3F1FB;strokeColor=#8EC1E6;strokeWidth=1;fontSize=13;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="250" y="422" width="170" height="64" as="geometry" /></mxCell><mxCell id="p2-29" value="&lt;b&gt;Discount&lt;/b&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3F1FB;strokeColor=#8EC1E6;strokeWidth=1;fontSize=13;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRig