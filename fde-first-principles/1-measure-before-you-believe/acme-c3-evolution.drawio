=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-147" target="p1-148"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="2 · Inside C3: the graph decides, the model writes" name="2 · Inside C3: the graph decides, the model writes"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2-1" value="Inside C3: the graph decides, the model writes" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=26;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1400" height="34" as="geometry"/></mxCell><mxCell id="p2-2" value="What must be right (money, eligibility, escalation, which article) is worked out from the ontology and the business rules before the model writes a word, and checked again before anything is sent." style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#3E6489;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1640" height="40" as="geometry"/></mxCell><mxCell id="p2-3" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBFDFF;strokeColor=#8EC1E6;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="206" y="128" width="884" height="196" as="geometry"/></mxCell><mxCell id="p2-4" value='&lt;span style="font-size:12px;color:#2C7BBF"&gt;&lt;b&gt;Deterministic&lt;/b&gt; · ontology + business rules · same email, same answer&lt;/span&gt;' style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="222" y="136" width="600" height="18" as="geometry"/></mxCell><mxCell id="p2-5" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBFDFF;strokeColor=#8EC1E6;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1306" y="128" width="228" height="196" as="geometry"/></mxCell><mxCell id="p2-6" value='&lt;span style="font-size:12px;color:#2C7BBF"&gt;&lt;b&gt;Deterministic&lt;/b&gt; · checks&lt;/span&gt;' style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1322" y="136" width="200" height="18" as="geometry"/></mxCell><mxCell id="p2-7" value='&lt;span style="font-size:12px;color:#7A97B3"&gt;&lt;b&gt;Probabilistic&lt;/b&gt; · LLM&lt;/span&gt;' style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#173A5E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1100" y="136" width="200" height="18" as="geometry"/></mxCell><mxCell id="p2-8" value='&lt;b&gt;Customer email&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3E6489"&gt;“Close my connection unless you give me the loyalty discount.”&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5FAFE;strokeColor=#B9D7EE;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=center;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="150" height="140" as="geometry"/></mxCell><mxCell id="p2-9" value='&lt;b&gt;1 · Find concepts&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3E6489"&gt;SKOS labels in English, Hinglish, Marathi resolve to one concept&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3F1FB;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=center;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="222" y="168" width="190" height="140" as="geometry"/></mxCell><mxCell id="p2-10" value='&lt;b&gt;2 · Walk the graph&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3E6489"&gt;OWL reasoning: subClassOf, documentedIn, countsTowardLimit + the customer record&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3F1FB;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=center;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="434" y="168" width="190" height="140" as="geometry"/></mxCell><mxCell id="p2-11" value='&lt;b&gt;3 · Apply the rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3E6489"&gt;₹500 per 30 days · tenure 13+ · once a year · escalation policy&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3F1FB;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=center;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="646" y="168" width="190" height="140" as="geometry"/></mxCell><mxCell id="p2-12" value='&lt;b&gt;4 · Decision envelope&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3E6489"&gt;headroom · offer decisions · escalation triggers · linked articles · glossary&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3F1FB;strokeColor=#2C7BBF;strokeWidth=2;fontSize=14;fontColor=#173A5E;align=center;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="858" y="168" width="214" height="140" as="geometry"/></mxCell><mxCell id="p2-13" value='&lt;b&gt;5 · Draft the reply&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3E6489"&gt;LLM + tools: define_term, check_entitlement, search_kb&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#5AA6DB;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=center;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1100" y="168" width="190" height="140" as="geometry"/></mxCell><mxCell id="p2-14" value='&lt;b&gt;6 · Check before send&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3E6489"&gt;policy guard · offers not allowed · English · other customers&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E3F1FB;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;align=center;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1322" y="168" width="196" height="140" as="geometry"/></mxCell><mxCell id="p2-15" value="&lt;b&gt;Send&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8EC1E6;strokeWidth=1;fontSize=14;fontColor=#173A5E;