                <mxCell id="gap_callout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;align=left;spacingLeft=14;" value="&lt;b&gt;Finding #1 · Unwired Island&lt;/b&gt;&lt;br&gt;&lt;br&gt;ontology.feature claims:&lt;br&gt;&lt;i&gt;&quot;Prompts, tools and graders read the same file.&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;In code, &lt;b&gt;zero&lt;/b&gt; production modules import &lt;b&gt;lab/ontology.py&lt;/b&gt;." vertex="1">
                    <mxGeometry height="226" width="260" x="1280" y="145" as="geometry"/>
                </mxCell>
                <mxCell id="e_disc1" edge="1" parent="1" source="ont_py" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;dashed=1;endArrow=open;endFill=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" target="vb_box" value="not wired">
