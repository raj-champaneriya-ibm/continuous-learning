                <mxCell id="e_disc2" edge="1" parent="1" source="ont_py" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;dashed=1;endArrow=open;endFill=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" target="ev_box" value="not wired (duplicates regex)">
