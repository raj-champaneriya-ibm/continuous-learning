                </mxCell>
                <mxCell id="s_t2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=2;fontColor=#000000;" value="How to turn prose policy rules into traversable edges while strictly enforcing Policy Rule 5 (single-customer isolation)." vertex="1">
