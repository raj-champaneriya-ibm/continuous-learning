                <mxCell id="old_llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;dashed=1;fontColor=#000000;" value="&lt;b&gt;Small LLM (qwen3:4b)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Asked to simultaneously:&lt;br&gt;1. Translate Hinglish terms&lt;br&gt;2. Compute 12-month date windows&lt;br&gt;3. Multiply 50% × ₹1,499 + credits&lt;br&gt;4. Decide escalation &amp;amp; write email" vertex="1">
                    <mxGeometry height="220" width="280" x="300" y="1035" as="geometry"/>
                </mxCell>
                <mxCell id="old_out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" value="54% Safe&lt;br&gt;38/40 Esc. Missed" vertex="1">
                    <mxGeometry height="80" width="140" x="620" y="1105" as="geometry"/>
                </mxCell>
