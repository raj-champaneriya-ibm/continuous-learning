                    </mxGeometry>
                </mxCell>
                <mxCell id="p1_note" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#000000;" value="When an ontology is only serialized into a flat text block (glossary()), pyoxigraph is used as an expensive YAML loader. The graph structure is discarded before reasoning begins." vertex="1">
                    <mxGeometry height="40" width="900" x="60" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="p2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" value="" vertex="1">
                    <mxGeometry height="410" width="1520" x="40" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="p2t" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#000000;" value="2 · Five structural flaws in the current ontology implementation" vertex="1">
                    <mxGeometry height="30" width="900" x="60" y="512" as="geometry"/>
                </mxCell>
                <mxCell id="f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontFamily=Helvetica;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;" value="&lt;b&gt;A · Prose-Trapped Business Rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rules live inside English strings:&lt;br&gt;&lt;i&gt;&quot;Only for tenure of 13 months or more, and no waiver in the last 12 months (late_fee_waived_on).&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Code cannot query &lt;b&gt;minTenure=13&lt;/b&gt; or &lt;b&gt;field=late_fee_waived_on&lt;/b&gt; or &lt;b&gt;Pro=₹1499&lt;/b&gt;. The 4B LLM must parse prose and do arithmetic." vertex="1">
                    <mxGeometry height="215" width="280" x="60" y="555" as="geometry"/>
                </mxCell>
                <mxCell id="f2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontFamily=Helvetica;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;" value="&lt;b&gt;B · Zero Object Properties&lt;/b&gt;&lt;br&gt;&lt;br&gt;The graph has &lt;b&gt;rdfs:subClassOf&lt;/b&gt; (taxonomy) and &lt;b&gt;skos:altLabel&lt;/b&gt; (thesaurus), but no domain edges:&lt;br&gt;— no &lt;i&gt;Plan&lt;/i&gt; (Basic/Plus/Pro prices)&lt;br&gt;— no &lt;i&gt;ServiceArea&lt;/i&gt; (8 Pune areas)&lt;br&gt;— no &lt;i&gt;Action → requiresRole&lt;/i&gt;&lt;br&gt;— no &lt;i&gt;Concept → documentedIn → KB&lt;/i&gt; (&quot;KB04, policy 8&quot; is a raw string)." vertex="1">
                    <mxGeometry height="215" width="280" x="360" y="555" as="geometry"/>
                </mxCell>
                <mxCell id="f3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontFamily=Helvetica;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;" value="&lt;b&gt;C · OWL Punning &amp;amp; No Inheritance&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;acme:countsTowardLimit&lt;/b&gt; is an &lt;i&gt;owl:DatatypeProperty&lt;/i&gt; asserted directly on &lt;i&gt;owl:Class&lt;/i&gt; subjects.&lt;br&gt;&lt;br&gt;Without a reasoner or inheritance query, properties do not flow down &lt;b&gt;rdfs:subClassOf+&lt;/b&gt;. Every subclass manually repeats &lt;i&gt;countsTowardLimit true&lt;/i&gt;." vertex="1">
                    <mxGeometry height="215" width="280" x="660" y="555" as="geometry"/>
                </mxCell>
                <mxCell id="f4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontFamily=Helvetica;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;" value="&lt;b&gt;D · Query &amp;amp; i18n Fragility&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;define(word)&lt;/b&gt; runs a full SPARQL scan + Python loop on every call instead of an O(1) cached alias index.&lt;br&gt;2. &lt;b&gt;TERMS&lt;/b&gt; lacks &lt;i&gt;FILTER(LANG(?label) = &quot;en&quot;)&lt;/i&gt;; adding a Hindi &lt;i&gt;prefLabel&lt;/i&gt; overwrites the English key.&lt;br&gt;3. Substring matching on emails is missing." vertex="1">
                    <mxGeometry height="215" width="280" x="960" y="555" as="geometry"/>
                </mxCell>
                <mxCell id="f5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontFamily=Helvetica;fontSize=13;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;" value="&lt;b&gt;E · Rule 5 Misconception&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rule 5 says: &lt;i&gt;never share another customer&#39;s details.&lt;/i&gt;&lt;br&gt;&lt;br&gt;Keeping &lt;b&gt;ontology.ttl&lt;/b&gt; free of PII is right. But refusing to join TBox rules with &lt;b&gt;one customer&#39;s ABox facts&lt;/b&gt; in an ephemeral per-request graph forces the LLM to do all rule evaluation!" vertex="1">
                    <mxGeometry height="215" width="280" x="1260" y="555" as="geometry"/>
                </mxCell>
                <mxCell id="p2_bottom" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;fontColor=#000000;" value="&lt;b&gt;Consequence observed in Day 9 &amp;amp; Day 10 evidence:&lt;/b&gt; Version B misses 38/40 escalations and fails on waiver cooldowns (c02, c47, c52) and ₹500 limits (c30). Version C misses facts (36% vs 74%) because word-overlap search doesn&#39;t traverse concept → KB edges. The grader has 8 @known_gap xfails (including &quot;50% off Pro plan&quot;)." vertex="1">
                    <mxGeometry height="90" width="1480" x="60" y="795" as="geometry"/>
                </mxCell>
                <mxCell id="p3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" value="" vertex="1">
                    <mxGeometry height="390" width="1520" x="40" y="935" as="geometry"/>
                </mxCell>
                <mxCell id="p3t" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#000000;" value="3 · Visual thinking: shifting from &quot;Passive Glossary&quot; to &quot;Business Graph Engine&quot;" vertex="1">
                    <mxGeometry height="30" width="900" x="60" y="948" as="geometry"/>
                </mxCell>
                <mxCell id="old_hdr" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#000000;" value="TODAY · Passive Prompt Glossary (LLM does the graph joins)" vertex="1">
