                <mxCell id="old_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" value="kb.md + policy.md&lt;br&gt;(unstructured text)" vertex="1">
