                    <mxGeometry height="22" width="160" x="880" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="e_m4" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#B71C1C;" value="D ≈ 1.01R (worst)" vertex="1">
                    <mxGeometry height="22" width="160" x="1050" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="e_t3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" value="Your +0.31R came from recipe A. Your +0.62R came from recipe C: flattering, but biased." vertex="1">
                    <mxGeometry height="60" width="350" x="875" y="538" as="geometry"/>
                </mxCell>
                <mxCell id="e_t3warn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="Pick the recipe &lt;b&gt;before&lt;/b&gt; you look at the result. Choosing the recipe that gives the nicest number is itself a biased recipe." vertex="1">
                    <mxGeometry height="95" width="350" x="875" y="610" as="geometry"/>
                </mxCell>

                <!-- Panel 4: Insight -->
                <mxCell id="e_p4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6FBF4;strokeColor=#82b366;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="660" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="e_h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="4 · INSIGHT" vertex="1">
                    <mxGeometry height="44" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="e_i1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;" value="A &lt;b&gt;point estimate&lt;/b&gt; is one best guess at a hidden number, made by a recipe (an &lt;b&gt;estimator&lt;/b&gt;) from your sample." vertex="1">
                    <mxGeometry height="85" width="350" x="1295" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="e_i2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Two ways a recipe can miss" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="237" as="geometry"/>
                </mxCell>
                <mxCell id="e_rBias" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="BIAS" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="265" as="geometry"/>
                </mxCell>
                <mxCell id="e_rBiasT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Off target on average. Built into the recipe." vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="265" as="geometry"/>
                </mxCell>
                <mxCell id="e_rScat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="SCATTER" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="309" as="geometry"/>
                </mxCell>
                <mxCell id="e_rScatT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Jumps around between samples. Shrinks like 1/√n." vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="309" as="geometry"/>
                </mxCell>
                <mxCell id="e_rMiss" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="MISS" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="353" as="geometry"/>
                </mxCell>
                <mxCell id="e_rMissT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Typical miss combines both: √(bias² + scatter²)" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="353" as="geometry"/>
                </mxCell>
                <mxCell id="e_i3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Biased recipes common in trading" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="402" as="geometry"/>
                </mxCell>
                <mxCell id="e_i3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" value="best of many backtests · trades you remember · dropping 'outlier' losses · counting only since the last tweak" vertex="1">
                    <mxGeometry height="48" width="350" x="1295" y="427" as="geometry"/>
                </mxCell>
                <mxCell id="e_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#2E7D32;" value="Van Tharp: estimate expectancy from all trades, out of sample, with enough trades." vertex="1">
                    <mxGeometry height="58" width="350" x="1295" y="482" as="geometry"/>
                </mxCell>
                <mxCell id="e_takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" value="Judge the recipe, not the result: an honest guess from enough trades beats a flattering one." vertex="1">
                    <mxGeometry height="95" width="350" x="1295" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="e_next" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#5B8C46;" value="Next concept: Confidence intervals" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="655" as="geometry"/>
                </mxCell>

                <mxCell id="e_e12" edge="1" parent="1" source="e_p1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="e_p2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_e23" edge="1" parent="1" source="e_p2" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="e_p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_e34" edge="1" parent="1" source="e_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="e_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Lesson notes -->
                <mxCell id="e_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="e_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="e_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="A &lt;b&gt;point estimate&lt;/b&gt; is a single best guess at a hidden number (like a system's true expectancy), computed from a sample by a recipe called an &lt;b&gt;estimator&lt;/b&gt;.&lt;br&gt;&lt;br&gt;A good recipe is right on average (low bias) and doesn't jump around much (low scatter)." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="e_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="e_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="You never see inside the bag; you only see trades. Yet you need numbers: the true win rate, the true expectancy.&lt;br&gt;&lt;br&gt;A recipe turns your trades into a guess. Different recipes give different guesses from the same trades.&lt;br&gt;&lt;br&gt;Since you can't check a guess against the truth, you judge the &lt;i&gt;recipe&lt;/i&gt;: how its guesses would land across many possible samples." vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="e_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual mental model: the dartboard" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="e_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="The bullseye is the hidden true value. Each dart is the estimate from one sample of trades.&lt;br&gt;&lt;br&gt;Greg Tang move: &lt;b&gt;sort the boards into a 2 × 2&lt;/b&gt;:&lt;br&gt;• on target and tight (the goal)&lt;br&gt;• on target but scattered (unbiased, noisy)&lt;br&gt;• off target but tight (biased, confident)&lt;br&gt;• off target and scattered (the worst)&lt;br&gt;&lt;br&gt;Bias = how far the cluster's center is from the bullseye. Variance = how spread out the cluster is." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="e_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: guessing a die's average" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="e_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="A die's true average is 3.5. Four recipes using 5 rolls:&lt;br&gt;&lt;br&gt;&lt;b&gt;average of the 5 rolls:&lt;/b&gt; on target, fairly tight&lt;br&gt;&lt;b&gt;first roll only:&lt;/b&gt; on target, very scattered&lt;br&gt;&lt;b&gt;highest of the 5 rolls:&lt;/b&gt; always too high (biased)&lt;br&gt;&lt;b&gt;always say 3:&lt;/b&gt; zero scatter, but always off by 0.5&lt;br&gt;&lt;br&gt;Zero scatter is not the same as accurate." vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="e_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="e_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="True expectancy +0.25R (SD 1.64R). Four recipes:&lt;br&gt;&lt;b&gt;A · average of 100 trades:&lt;/b&gt; on target; −0.08R to +0.58R&lt;br&gt;&lt;b&gt;B · average of last 10:&lt;/b&gt; on target; −0.79R to +1.29R&lt;br&gt;&lt;b&gt;C · best of 20 backtest settings (100 trades each, all truly +0.25R):&lt;/b&gt; lands around +0.56R&lt;br&gt;&lt;b&gt;D · best of 20 settings (10 trades each):&lt;/b&gt; around +1.22R&lt;br&gt;&lt;br&gt;Van Tharp warns about exactly this: optimizing over many settings flatters the backtest." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="e_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes when you change the recipe?" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="e_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;More trades:&lt;/b&gt; scatter shrinks like 1/√n. From B to A (10 → 100 trades), the range narrows from 2.08R wide to 0.66R wide.&lt;br&gt;&lt;br&gt;&lt;b&gt;More settings tried:&lt;/b&gt; the 'best' result drifts further above the truth. More trades per test reduce this bias, but never to zero while you keep picking the best.&lt;br&gt;&lt;br&gt;&lt;b&gt;Typical miss&lt;/b&gt; (bias and scatter combined): A ≈ 0.16R, C ≈ 0.32R, B ≈ 0.52R, D ≈ 1.01R." vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="e_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Misconception: 'my estimate is the truth'" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="e_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;'My estimate is the truth.'&lt;/b&gt; It is one dart. Another sample would give another number.&lt;br&gt;&lt;br&gt;&lt;b&gt;'Unbiased means right.'&lt;/b&gt; Unbiased means right &lt;i&gt;on average&lt;/i&gt; across samples. Recipe B is unbiased and still often misses by 0.5R or more.&lt;br&gt;&lt;br&gt;&lt;b&gt;'More data fixes everything.'&lt;/b&gt; More data shrinks scatter. A biased recipe (dropping 'outlier' losses, counting only remembered trades) stays biased no matter how many trades you add." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="e_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="e_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="θ = true value (hidden); θ̂ = estimate from a sample&lt;br&gt;&lt;br&gt;&lt;b&gt;Bias = E[θ̂] − θ&lt;/b&gt; (the average miss)&lt;br&gt;&lt;b&gt;Variance&lt;/b&gt; = spread of θ̂ across samples&lt;br&gt;&lt;b&gt;MSE = E[(θ̂ − θ)²] = bias² + variance&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sample mean: X̄ is unbiased, with SD = σ ÷ √n&lt;br&gt;&lt;br&gt;Sample variance: divide by n − 1, not n. The sample sits closer to its own average than to the true one, so dividing by n comes out too small." vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="e_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="e_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; the true expectancy is hidden; three different numbers from one system.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; four dartboards: on/off target × tight/scattered.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; four estimation recipes on the same system, with their ranges and typical misses.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; bias, scatter, typical miss; biased recipes common in trading; the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="e_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="e_n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="Judge the recipe, not the result: an honest guess from enough trades beats a flattering one." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
