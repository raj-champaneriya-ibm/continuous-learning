                <mxCell id="c_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#2E7D32;" value="Van Tharp: before you blame the system, count how often a bad stretch should happen anyway." vertex="1">
                    <mxGeometry height="65" width="350" x="1295" y="470" as="geometry"/>
                </mxCell>
                <mxCell id="c_takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" value="Before calling a streak rare, count how many paths lead to it." vertex="1">
                    <mxGeometry height="95" width="350" x="1295" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="c_next" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#5B8C46;" value="Next concept: Conditional probability (zoom into one circle)" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="c_e12" edge="1" parent="1" source="c_p1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="c_p2">
