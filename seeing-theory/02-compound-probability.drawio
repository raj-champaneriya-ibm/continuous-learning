                <mxCell id="k_fil2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E7D32;" value="Trend days only: 40 trades → +50R (+1.25R each)" vertex="1">
