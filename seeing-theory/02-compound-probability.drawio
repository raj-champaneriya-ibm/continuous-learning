                </mxCell>
                <mxCell id="k_t3warn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="Only trust a condition you can know &lt;b&gt;before&lt;/b&gt; the trade, tested on enough trades (Chance Events: the wobble)." vertex="1">
