                    <mxGeometry height="38" width="80" x="1295" y="324" as="geometry"/>
                </mxCell>
                <mxCell id="c_rGrpT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Order doesn&#39;t matter? Which 2 of 4 trades won: (4 × 3) ÷ 2 = 6 ways" vertex="1">
