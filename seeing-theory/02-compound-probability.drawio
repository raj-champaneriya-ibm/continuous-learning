                </mxCell>
                <mxCell id="k_h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="4 · INSIGHT" vertex="1">
                    <mxGeometry height="44" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="k_i1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;" value="&lt;b&gt;Conditional probability&lt;/b&gt; = the chance of A once you know B is true. Zoom into B&#39;s box and recount A inside it." vertex="1">
                    <mxGeometry height="80" width="350" x="1295" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="k_i2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Three habits" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="232" as="geometry"/>
                </mxCell>
                <mxCell id="k_rZoom" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="ZOOM" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="260" as="geometry"/>
                </mxCell>
                <mxCell id="k_rZoomT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Shrink the box to the cases where the condition holds" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="260" as="geometry"/>
                </mxCell>
                <mxCell id="k_rRec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="RECOUNT" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="304" as="geometry"/>
                </mxCell>
                <mxCell id="k_rRecT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="New denominator: the size of the smaller box" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="304" as="geometry"/>
                </mxCell>
                <mxCell id="k_rFlip" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="DON&#39;T FLIP" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="348" as="geometry"/>
                </mxCell>
                <mxCell id="k_rFlipT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="P(A | B) is not P(B | A): they use different boxes" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="348" as="geometry"/>
                </mxCell>
                <mxCell id="k_i3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="The flip trap, in plain words" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="396" as="geometry"/>
                </mxCell>
                <mxCell id="k_i3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" value="&#39;90% of blown accounts used high leverage&#39; is &lt;b&gt;not&lt;/b&gt; &#39;90% of high-leverage accounts blow up.&#39;" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="421" as="geometry"/>
                </mxCell>
                <mxCell id="k_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#2E7D32;" value="Van Tharp-style improvement: find conditions that change P(win) or the R-multiples, then test them on enough trades." vertex="1">
                    <mxGeometry height="62" width="350" x="1295" y="477" as="geometry"/>
                </mxCell>
                <mxCell id="k_takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" value="New information changes the box. Always ask: &#39;out of which trades?&#39;" vertex="1">
                    <mxGeometry height="95" width="350" x="1295" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="k_next" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#5B8C46;" value="Next chapter: Probability distributions (random variables)" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="k_e12" edge="1" parent="1" source="k_p1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="k_p2">
