                <mxCell id="c_h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="4 · INSIGHT" vertex="1">
                    <mxGeometry height="44" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="c_i1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;" value="&lt;b&gt;Counting&lt;/b&gt; turns &#39;how likely?&#39; into &#39;how many ways?&#39;: favorable ways ÷ all ways, when every way is equally likely." vertex="1">
                    <mxGeometry height="80" width="350" x="1295" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="c_rMul" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=12;fontStyle=1;" value="MULTIPLY" vertex="1">
