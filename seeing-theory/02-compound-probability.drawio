                    <mxGeometry height="28" width="200" x="1295" y="432" as="geometry"/>
                </mxCell>
                <mxCell id="c_seqBv" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" value="1 in 1,024" vertex="1">
