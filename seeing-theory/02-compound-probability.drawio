                <mxCell id="s_notW" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;" value="W" vertex="1">
                    <mxGeometry height="30" width="14" x="984" y="325" as="geometry"/>
                </mxCell>
                <mxCell id="s_notL" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;" value="L" vertex="1">
                    <mxGeometry height="30" width="14" x="984" y="355" as="geometry"/>
                </mxCell>
                <mxCell id="s_notTL" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontSize=11;fontColor=#9E9E9E;" value="30" vertex="1">
                    <mxGeometry height="30" width="50" x="1000" y="325" as="geometry"/>
                </mxCell>
                <mxCell id="s_notTR" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontSize=11;fontColor=#9E9E9E;" value="15" vertex="1">
                    <mxGeometry height="30" width="50" x="1050" y="325" as="geometry"/>
                </mxCell>
                <mxCell id="s_notBL" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="10" vertex="1">
                    <mxGeometry height="30" width="50" x="1000" y="355" as="geometry"/>
                </mxCell>
                <mxCell id="s_notBR" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="45" vertex="1">
                    <mxGeometry height="30" width="50" x="1050" y="355" as="geometry"/>
                </mxCell>
                <mxCell id="s_notRes" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" value="everything outside W:&lt;br&gt;100 − 45 = 55" vertex="1">
                    <mxGeometry height="60" width="125" x="1110" y="325" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcT" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" value="Why 40 + 45 is wrong" vertex="1">
                    <mxGeometry height="20" width="340" x="880" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcLbl" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" value="T column (40)&lt;br&gt;+ W row (45)&lt;br&gt;= 85" vertex="1">
                    <mxGeometry height="60" width="105" x="875" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcTL" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;strokeWidth=2;fontSize=11;fontStyle=1;" value="30 ×2" vertex="1">
                    <mxGeometry height="30" width="50" x="1000" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcTR" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="15" vertex="1">
                    <mxGeometry height="30" width="50" x="1050" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcBL" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="10" vertex="1">
                    <mxGeometry height="30" width="50" x="1000" y="455" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcBR" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontSize=11;fontColor=#9E9E9E;" value="45" vertex="1">
                    <mxGeometry height="30" width="50" x="1050" y="455" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcRes" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#E65100;" value="the overlap box was counted twice:&lt;br&gt;85 − 30 = 55" vertex="1">
                    <mxGeometry height="60" width="125" x="1110" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="s_slT" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" value="Slide the circles: the overlap sets the OR count" vertex="1">
                    <mxGeometry height="20" width="340" x="880" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="s_v1T" parent="1" style="ellipse;html=1;fillColor=#7EA6E0;fillOpacity=45;strokeColor=#6c8ebf;" value="" vertex="1">
