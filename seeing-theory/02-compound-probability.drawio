                </mxCell>
                <mxCell id="c_rOrd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=12;fontStyle=1;" value="ORDER" vertex="1">
