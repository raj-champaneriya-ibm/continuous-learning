                </mxCell>
                <mxCell id="c_rOrdT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Order matters? Line up 4 setups: 4 × 3 × 2 × 1 = 24 ways" vertex="1">
