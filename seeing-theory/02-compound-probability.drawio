                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_e34" edge="1" parent="1" source="c_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="c_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="c_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="c_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="When every outcome is equally likely, probability = &lt;b&gt;favorable ways ÷ all ways&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Counting shortcuts let you find both numbers without listing everything." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="c_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="c_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="For one coin flip you can list the outcomes. For 10 trades there are 1,024 possible win/loss sequences; for 20 trades, over a million.&lt;br&gt;&lt;br&gt;Counting rules exist so you can answer &lt;i&gt;how many ways can this happen?&lt;/i&gt; without writing every case down.&lt;br&gt;&lt;br&gt;Once you know the number of ways, probability is a simple division." vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="c_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual model: the branching tree" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="c_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Each trade splits every path in two (W or L): 2 → 4 → 8 → … → 1,024 after 10 trades.&lt;br&gt;&lt;br&gt;&lt;b&gt;group the leaves&lt;/b&gt; by number of wins. For 3 trades the 8 paths form groups of 1 · 3 · 3 · 1; for 4 trades, 1 · 4 · 6 · 4 · 1.&lt;br&gt;&lt;br&gt;The groups pile up highest in the middle because there are more ways to mix wins and losses than to get all of one kind." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="c_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: three trades" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="c_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Three trades from a 50/50 system:&lt;br&gt;&lt;br&gt;All paths: 2 × 2 × 2 = 8&lt;br&gt;Exactly 2 wins: WWL, WLW, LWW = 3 paths&lt;br&gt;P(exactly 2 wins) = 3 ÷ 8 = 37.5%&lt;br&gt;P(all 3 lose) = 1 ÷ 8 = 12.5%&lt;br&gt;&lt;br&gt;&lt;b&gt;Order vs no order:&lt;/b&gt; which 2 of 4 trades won? Ordered picks: 4 × 3 = 12. Each pair was picked twice (A then B, B then A), so 12 ÷ 2 = &lt;b&gt;6&lt;/b&gt; groups." vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="c_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="c_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="A 50% win-rate system gives you 3 wins in your last 10 trades. Broken?&lt;br&gt;&lt;br&gt;Count: 1,024 possible 10-trade sequences. Ways to get 3 wins or fewer: 1 + 10 + 45 + 120 = 176.&lt;br&gt;176 ÷ 1,024 ≈ &lt;b&gt;17%&lt;/b&gt;, about 1 stretch in 6.&lt;br&gt;&lt;br&gt;Van Tharp&#39;s point: bad stretches are built into every system. Count how often they should happen before you change anything." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="c_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes: more trades" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="c_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Paths double with each trade:&lt;/b&gt; 3 → 8, 4 → 16, 10 → 1,024, 20 → 1,048,576.&lt;br&gt;&lt;br&gt;&lt;b&gt;Any exact count gets less likely:&lt;/b&gt; exactly half wins is 6/16 = 37.5% at 4 trades but 252/1,024 ≈ 25% at 10 trades. Yet 4 to 6 wins out of 10 still covers ≈ 66%.&lt;br&gt;&lt;br&gt;&lt;b&gt;Order matters:&lt;/b&gt; lining up 4 setups = 24 ways.&lt;br&gt;&lt;b&gt;Order doesn&#39;t:&lt;/b&gt; choosing 2 of 4 = 6 ways." vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="c_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Common misconceptions" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="c_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;&#39;WWWWWLLLLL is less likely than WLLWLWWLWL.&#39;&lt;/b&gt; Every exact sequence has the same chance: 1 in 1,024. The mixed one only &lt;i&gt;looks&lt;/i&gt; typical because mixed patterns make up most of the 252 ways to get 5 wins.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;The most likely result should usually happen.&#39;&lt;/b&gt; Exactly 5 wins in 10 is the most likely count, yet it happens only about 1 time in 4." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="c_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="c_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Multiplication rule:&lt;/b&gt; choices in a row multiply, so n trades give 2ⁿ paths.&lt;br&gt;&lt;br&gt;&lt;b&gt;Permutations&lt;/b&gt; (order matters):&lt;br&gt;n! = n × (n − 1) × … × 1&lt;br&gt;&lt;br&gt;&lt;b&gt;Combinations&lt;/b&gt; (order doesn&#39;t matter):&lt;br&gt;C(n, k) = n! ÷ (k! × (n − k)!)&lt;br&gt;C(4, 2) = (4 × 3) ÷ (2 × 1) = 6&lt;br&gt;C(10, 5) = 252&lt;br&gt;&lt;br&gt;Equally likely outcomes: P = favorable ÷ total&lt;br&gt;50/50 system: P(exactly k wins in n) = C(n, k) ÷ 2ⁿ" vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="c_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="c_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; 3 wins in 10 from a 50/50 system. Is that rare?&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; the branching tree doubles the paths; group the leaves by wins.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; all 16 four-trade sequences piled by wins (1 · 4 · 6 · 4 · 1), then scaled up to 10 trades.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; multiply, order, group; every exact sequence is equally rare; the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="c_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="c_n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="Before calling a streak rare, count how many paths lead to it." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
