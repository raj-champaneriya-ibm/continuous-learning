                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="k_e34" edge="1" parent="1" source="k_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="k_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="k_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="k_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="k_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Conditional probability is the chance of something &lt;b&gt;once you already know something else is true&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Zoom into the cases where the condition holds, and recount there." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="k_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="k_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Your system wins 45% of the time overall. But you never trade &#39;overall&#39;; you trade today, and today has features: trend or chop, news or quiet.&lt;br&gt;&lt;br&gt;New information shrinks the set of cases that matter. Conditional probability is the bookkeeping for that. It answers: &lt;i&gt;out of the trades like this one, how many won?&lt;/i&gt;" vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="k_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual model: the spotlight" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="k_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Shine a spotlight on the trend-day column of the four-box and grey out the rest. That column becomes the whole box: 40 trades.&lt;br&gt;&lt;br&gt;&lt;b&gt;stretch the slice to fill the box&lt;/b&gt;. The trend-day bar (30 wins, 10 losses) is stretched to full width, so it reads 75% / 25%.&lt;br&gt;&lt;br&gt;Same 30 winners; new denominator (40 instead of 100)." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="k_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: a hinted die" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="k_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Roll a die. P(6) = 1 of 6.&lt;br&gt;&lt;br&gt;Told &#39;it&#39;s even&#39;: the box shrinks to {2, 4, 6}, so P(6 | even) = 1 of 3.&lt;br&gt;Told &#39;it&#39;s odd&#39;: the box is {1, 3, 5}, so P(6 | odd) = 0.&lt;br&gt;Told &#39;it&#39;s at least 2&#39;: {2, 3, 4, 5, 6}, so 1 of 5.&lt;br&gt;&lt;br&gt;The 6 never changed. The box around it did." vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="k_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="k_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Wins +2R, losses −1R, 100 trades:&lt;br&gt;• every day: 45 wins → +35R (+0.35R per trade)&lt;br&gt;• trend days only: 30 of 40 win → +50R (+1.25R per trade)&lt;br&gt;• other days: 15 of 60 win → −15R (−0.25R per trade)&lt;br&gt;&lt;br&gt;Skipping 60 trades earns 15R more. That is Van Tharp-style incremental improvement: find a condition that changes the odds, then test it on enough trades." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="k_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes: the condition" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="k_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Change the condition:&lt;/b&gt; no condition 45%, trend day 75%, other day 25%.&lt;br&gt;&lt;br&gt;&lt;b&gt;Flip the question:&lt;/b&gt; P(win | trend) = 30 ÷ 40 = 75%, but P(trend | win) = 30 ÷ 45 ≈ 67%. Same overlap, different box.&lt;br&gt;&lt;br&gt;&lt;b&gt;If both columns had the same win rate&lt;/b&gt; (say 18 of 40 and 27 of 60, both 45%), the condition would tell you nothing. That is &lt;i&gt;independence&lt;/i&gt;, and the filter would be useless." vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="k_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Common misconceptions" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="k_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;&#39;P(A | B) = P(B | A).&#39;&lt;/b&gt; &#39;90% of blown accounts used high leverage&#39; does not mean &#39;90% of high-leverage accounts blow up&#39;. The first divides by blown accounts; the second by leveraged accounts.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;A great slice is a great filter.&#39;&lt;/b&gt; A condition found by slicing past trades many ways may just be luck. The filter must be knowable before the trade and confirmed on fresh trades." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="k_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="k_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Read &#39;|&#39; as &#39;given&#39; or &#39;among&#39;.&lt;br&gt;&lt;br&gt;&lt;b&gt;P(A | B) = P(A ∩ B) ÷ P(B)&lt;/b&gt;&lt;br&gt;P(W | T) = 0.30 ÷ 0.40 = 0.75&lt;br&gt;P(T | W) = 0.30 ÷ 0.45 ≈ 0.67&lt;br&gt;&lt;br&gt;&lt;b&gt;Multiplication rule:&lt;/b&gt;&lt;br&gt;P(A ∩ B) = P(B) × P(A | B)&lt;br&gt;0.40 × 0.75 = 0.30&lt;br&gt;&lt;br&gt;&lt;b&gt;Independence:&lt;/b&gt; P(A | B) = P(A), so knowing B changes nothing." vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="k_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="k_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; 45% overall, but trend-day and other-day streaks look very different.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; spotlight one column, then stretch the slice to fill the box.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; change the condition, flip the question, and filter the system in R.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; zoom, recount, don&#39;t flip; the leverage trap; the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
