                </mxCell>
                <mxCell id="c_i3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Every exact sequence is equally rare" vertex="1">
                    <mxGeometry height="24" width="350" x="1295" y="372" as="geometry"/>
                </mxCell>
                <mxCell id="c_seqA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontFamily=Courier New;fontSize=13;fontStyle=1;" value="WWWWWLLLLL" vertex="1">
