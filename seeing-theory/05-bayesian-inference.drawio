                <mxCell id="l_t1c" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" value="Usually we ask what data a known truth will produce. Here it&#39;s backwards: we have the data and must judge the possible truths." vertex="1">
