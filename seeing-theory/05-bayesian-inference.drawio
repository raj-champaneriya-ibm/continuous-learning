                <mxCell id="l_e23" edge="1" parent="1" source="l_p2" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l_p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l_e34" edge="1" parent="1" source="l_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="l_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="l_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="The &lt;b&gt;likelihood function&lt;/b&gt; holds your data fixed and scores every possible true value by how probable it would make that exact data.&lt;br&gt;&lt;br&gt;The highest score is the best explanation." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="l_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="l_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Usually we ask: &lt;i&gt;given the truth, what data will we see?&lt;/i&gt; After trading, you have the data and want the truth.&lt;br&gt;&lt;br&gt;So try every candidate truth: if the win rate were 40%, how likely is 6 wins in 10? If 60%? If 80%? Each answer is a score.&lt;br&gt;&lt;br&gt;The scores for all candidates form a curve. Its peak is the best explanation; its width shows how many truths still fit." vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="l_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual mental model: the suspect line-up" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="l_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Each candidate win rate (10%, 20%, …, 90%) steps forward and is scored on how well it would have produced your 6 wins in 10.&lt;br&gt;&lt;br&gt;&lt;b&gt;line them up as bars&lt;/b&gt;. 60% scores highest (25%), but 50% (21%) and 70% (20%) are close behind; 10% and 90% score nearly zero." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="l_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: a mystery coin" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="l_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Flip a mystery coin 3 times: H H H.&lt;br&gt;&lt;br&gt;Fair coin (50% heads): 0.5³ = 12.5%&lt;br&gt;75%-heads coin: 0.75³ ≈ 42%&lt;br&gt;Two-headed coin (100%): 1³ = 100%&lt;br&gt;&lt;br&gt;The two-headed coin explains HHH best. But two-headed coins are rare, so it isn&#39;t the most &lt;i&gt;probable&lt;/i&gt; coin. That&#39;s why Bayes multiplies the likelihood by the prior." vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="l_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="l_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Journal: 6 wins in 10 trades. Likelihood of that result:&lt;br&gt;40%: 11% · 50%: 21% · &lt;b&gt;60%: 25%&lt;/b&gt; · 70%: 20% · 80%: 9%&lt;br&gt;&lt;br&gt;Anything from about 40% to 80% explains your data reasonably. 60% beats &#39;coin flip&#39; (50%) by only 1.2×.&lt;br&gt;&lt;br&gt;After 100 trades with 60 wins, 60% beats 50% by about 7.5×, and the plausible range shrinks to roughly 50% to 70%.&lt;br&gt;&lt;br&gt;Van Tharp&#39;s point again: small samples can&#39;t tell a mediocre system from a good one." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="l_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes when you add data?" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="l_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;More trades, same win share:&lt;/b&gt; the peak stays at 60% and the curve narrows. At 10 trades, 50% scores 82% of the peak; at 100 trades, only 13%.&lt;br&gt;&lt;br&gt;&lt;b&gt;Different data:&lt;/b&gt; 3 wins in 10 moves the peak to 30%.&lt;br&gt;&lt;br&gt;&lt;b&gt;Comparing two truths:&lt;/b&gt; the likelihood ratio of 60% vs 50% grows from 1.2× (10 trades) to about 7.5× (100 trades)." vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="l_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Misconception: &#39;likelihood = chance it&#39;s true&#39;" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="l_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;&#39;L(60%) = 25% means a 25% chance the win rate is 60%.&#39;&lt;/b&gt; No. It&#39;s the chance of &lt;i&gt;your data&lt;/i&gt; if the win rate were 60%. The nine bars add to about 0.91, not 1.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;The peak is the truth.&#39;&lt;/b&gt; The peak is the best explanation of this sample; the width says how far the truth might be.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;Best explanation = most probable.&#39;&lt;/b&gt; Only if every candidate was equally likely to begin with (see the mystery coin)." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="l_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="l_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Data fixed, parameter varies:&lt;br&gt;&lt;b&gt;L(p | data) = P(data | p)&lt;/b&gt;&lt;br&gt;&lt;br&gt;k wins in n trades:&lt;br&gt;L(p) = C(n, k) × p&lt;sup&gt;k&lt;/sup&gt; × (1 − p)&lt;sup&gt;n − k&lt;/sup&gt;&lt;br&gt;L(0.6) = 210 × 0.6⁶ × 0.4⁴ ≈ 0.25&lt;br&gt;&lt;br&gt;Maximum likelihood estimate: p̂ = k ÷ n = 0.6&lt;br&gt;&lt;br&gt;Likelihood ratio: L(0.6) ÷ L(0.5) ≈ 1.22 (n = 10), ≈ 7.5 (n = 100)&lt;br&gt;&lt;br&gt;Bayes: posterior ∝ likelihood × prior" vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="l_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="l_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; 6 wins in 10 trades and several candidate win rates.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; each candidate auditions; the bars form the likelihood function.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; 10 vs 100 trades; the 60% vs 50% ratio; different data moves the peak.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; peak, width, ratio; not a probability of the truth; the Bayes link; the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="l_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="l_n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="Hold the data fixed and let the truth slide: the peak is the best explanation, the width is the honesty." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
