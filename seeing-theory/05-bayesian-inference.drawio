                <mxCell id="l_i1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;" value="The &lt;b&gt;likelihood function&lt;/b&gt; scores every possible true value by how probable it makes the data you actually saw." vertex="1">
