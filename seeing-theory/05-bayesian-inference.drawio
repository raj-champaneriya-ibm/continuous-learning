                <mxCell id="q_i3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" value="Update after each block of trades. Your belief keeps learning without starting over." vertex="1">
                    <mxGeometry height="48" width="350" x="1295" y="427" as="geometry"/>
                </mxCell>
                <mxCell id="q_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#2E7D32;" value="Van Tharp-style: keep a running, honest belief about each system, and let every new batch of trades move it." vertex="1">
