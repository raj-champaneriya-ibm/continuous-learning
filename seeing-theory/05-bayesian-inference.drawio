                <mxCell id="l_rPkT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Best single explanation (maximum likelihood: 6 ÷ 10 = 60%)" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="265" as="geometry"/>
                </mxCell>
