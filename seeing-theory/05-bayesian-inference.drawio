                </mxCell>
                <mxCell id="l_rRt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="RATIO" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="353" as="geometry"/>
                </mxCell>
                <mxCell id="l_rRtT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Compare two truths: 60% vs 50% is 1.2× after 10 trades, ≈ 7.5× after 100" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="353" as="geometry"/>
                </mxCell>
                <mxCell id="l_i3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Not a probability of the truth" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="402" as="geometry"/>
                </mxCell>
                <mxCell id="l_i3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" value="Each bar is the chance of the &lt;i&gt;data&lt;/i&gt;, given one truth. The nine bars add to about 0.91, not 1." vertex="1">
                    <mxGeometry height="48" width="350" x="1295" y="427" as="geometry"/>
                </mxCell>
                <mxCell id="l_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#2E7D32;" value="Bayes link: the likelihood ratio is the odds multiplier from the last tab. Prior × likelihood → posterior." vertex="1">
                    <mxGeometry height="58" width="350" x="1295" y="482" as="geometry"/>
                </mxCell>
                <mxCell id="l_takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" value="Hold the data fixed and let the truth slide: the peak is the best explanation, the width is the honesty." vertex="1">
                    <mxGeometry height="95" width="350" x="1295" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="l_next" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#5B8C46;" value="Next concept: From prior to posterior" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="l_e12" edge="1" parent="1" source="l_p1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l_p2">
                    <mxGeometry relative="1" as="geometry"/>
