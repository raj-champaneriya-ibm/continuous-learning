                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="y_e34" edge="1" parent="1" source="y_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="y_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="y_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="y_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="y_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Bayes&#39; theorem&lt;/b&gt; updates a belief with evidence.&lt;br&gt;&lt;br&gt;Start from how common something is (the &lt;b&gt;prior&lt;/b&gt;), weigh it by how well it explains the evidence (the &lt;b&gt;likelihood&lt;/b&gt;), and get the updated belief (the &lt;b&gt;posterior&lt;/b&gt;)." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="y_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="y_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="The test answers &lt;i&gt;how often does a real edge pass?&lt;/i&gt; (80%). You want the flip: &lt;i&gt;given it passed, how likely is it real?&lt;/i&gt;&lt;br&gt;&lt;br&gt;Conditional probability warned that flipping needs care. Bayes is the correct way to flip, and it needs one extra ingredient: how common real edges were to begin with.&lt;br&gt;&lt;br&gt;When the thing you&#39;re looking for is rare, lucky passes from the common case can outnumber true ones." vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="y_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual mental model: count 1,000 ideas" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="y_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="100 real → 80 pass, 20 fail&lt;br&gt;900 no edge → 180 pass, 720 fail&lt;br&gt;&lt;br&gt;&lt;b&gt;spotlight only the passes&lt;/b&gt;: 80 + 180 = 260. Of those, 80 are real: 80 ÷ 260 ≈ 31%.&lt;br&gt;&lt;br&gt;Counting strategies (or people) instead of juggling percentages makes Bayes obvious. It is the same spotlight move as conditional probability." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="y_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: a medical test" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="y_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="A condition affects 1 in 100 people. A test catches 90% of cases but also flags 10% of healthy people.&lt;br&gt;&lt;br&gt;1,000 people:&lt;br&gt;10 sick → 9 test positive&lt;br&gt;990 healthy → 99 test positive&lt;br&gt;Positives: 9 + 99 = 108&lt;br&gt;P(sick | positive) = 9 ÷ 108 ≈ &lt;b&gt;8%&lt;/b&gt;&lt;br&gt;&lt;br&gt;A &#39;90% accurate&#39; test, yet a positive means only 8%." vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="y_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="y_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="1 in 10 ideas has a real edge. A real edge passes the backtest 80% of the time; a no-edge idea passes 20% of the time.&lt;br&gt;&lt;br&gt;After a backtest pass: ≈ 31% real&lt;br&gt;+ independent out-of-sample pass: ≈ 64%&lt;br&gt;+ small-size live pass: ≈ 88%&lt;br&gt;&lt;br&gt;Van Tharp-style improvement: don&#39;t bet big on one good backtest. Stack independent tests; each one multiplies the odds." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="y_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes when you turn a dial?" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="y_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Prior&lt;/b&gt; (how common real edges are):&lt;br&gt;1 in 100 → a pass means ≈ 4%&lt;br&gt;1 in 10 → ≈ 31%&lt;br&gt;1 in 2 → ≈ 80%&lt;br&gt;&lt;br&gt;&lt;b&gt;Test strictness&lt;/b&gt; (how often no-edge ideas pass):&lt;br&gt;40% → ≈ 18% · 20% → ≈ 31% · 5% → ≈ 64%&lt;br&gt;&lt;br&gt;&lt;b&gt;More independent passes:&lt;/b&gt;&lt;br&gt;10% → 31% → 64% → 88%" vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="y_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Misconception: &#39;an 80% test means 80% sure&#39;" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="y_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;&#39;An 80% test that says yes means 80% sure.&#39;&lt;/b&gt; That ignores the base rate. When real edges are rare, most passes are lucky no-edge ideas.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;P(pass | real) = P(real | pass).&#39;&lt;/b&gt; The flip trap from conditional probability: 80% vs 31%.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;Rerunning the backtest is another test.&#39;&lt;/b&gt; Only independent evidence (new data, a new period, live trading) should update the odds again." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="y_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="y_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;P(H | E) = P(E | H) × P(H) ÷ P(E)&lt;/b&gt;&lt;br&gt;P(E) = P(E | H) × P(H) + P(E | not H) × P(not H)&lt;br&gt;&lt;br&gt;0.8 × 0.1 ÷ (0.8 × 0.1 + 0.2 × 0.9)&lt;br&gt;= 0.08 ÷ 0.26 ≈ 0.31&lt;br&gt;&lt;br&gt;&lt;b&gt;Odds form:&lt;/b&gt;&lt;br&gt;posterior odds = prior odds × likelihood ratio&lt;br&gt;1 : 9 × (0.8 ÷ 0.2 = 4) = 4 : 9 → 4 ÷ 13 ≈ 31%&lt;br&gt;Each independent pass multiplies the odds by 4 again." vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="y_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="y_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; a backtest pass, an &#39;80% test&#39;, and the missing base rate.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; 1,000 ideas split into real or no edge, then pass or fail; spotlight the 260 passes.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; belief after 1, 2 and 3 passes; the prior dial; the test-strictness dial.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; prior, likelihood, posterior; the odds shortcut; the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="y_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="y_n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="Evidence doesn&#39;t replace what you knew; it updates it. Start from the base rate, then multiply." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>