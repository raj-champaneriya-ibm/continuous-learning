                <mxCell id="l_cloud" parent="1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=14;fontStyle=2;" value="Which true win rate best explains&lt;div&gt;&amp;nbsp;what I saw?&lt;/div&gt;" vertex="1">
                    <mxGeometry height="130" width="300" x="60" y="330" as="geometry"/>
