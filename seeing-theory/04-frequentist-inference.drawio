                </mxCell>
                <mxCell id="i_t1c" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Same system, different luck: +0.05R, +0.12R, &lt;b&gt;+0.31R (yours)&lt;/b&gt;, +0.38R, +0.47R. One is close to zero." vertex="1">
