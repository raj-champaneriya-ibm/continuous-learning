                <mxCell id="b_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Bootstrapping&lt;/b&gt; estimates how much a result could wobble by resampling your own data, with replacement, many times.&lt;br&gt;&lt;br&gt;Your journal stands in for the hidden bag." vertex="1">
