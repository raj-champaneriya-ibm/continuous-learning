                <mxCell id="i_e23" edge="1" parent="1" source="i_p2" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="i_p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="i_e34" edge="1" parent="1" source="i_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="i_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="i_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="i_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="i_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="A &lt;b&gt;confidence interval&lt;/b&gt; is a range built from your sample by a recipe that catches the true value in, say, 95 out of 100 samples.&lt;br&gt;&lt;br&gt;It shows how far off your single guess could be." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="i_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="i_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Your journal says +0.31R per trade. Another 100 trades from the same system could say +0.05R or +0.47R. A single number hides that.&lt;br&gt;&lt;br&gt;The central limit theorem told us how much averages wobble: about 2 × SD ÷ √n either way, 19 times in 20. A confidence interval puts that wobble around your estimate, so you can see what the truth could plausibly be." vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="i_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual mental model: ring toss" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="i_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="The true value is a fixed peg you can&#39;t see. Each sample throws a ring of the same width, centered on its own guess. A 95% recipe makes rings that land around the peg 19 times in 20.&lt;br&gt;&lt;br&gt;Greg Tang move: &lt;b&gt;line up 20 rings and count the hits&lt;/b&gt;: 19 catch the peg, 1 misses. The peg never moves; the rings do." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="i_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: is the coin fair?" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="i_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Flip a coin 100 times: 56 heads.&lt;br&gt;Estimate: 0.56&lt;br&gt;Wobble (SE): √(0.5 × 0.5 ÷ 100) = 0.05&lt;br&gt;95% interval: 0.56 ± 0.10 → 0.46 to 0.66&lt;br&gt;&lt;br&gt;0.50 is inside, so 56 heads is not evidence of a biased coin.&lt;br&gt;&lt;br&gt;With 400 flips and 56% heads: ± 0.05 → 0.51 to 0.61. Now 0.50 is outside." vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="i_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="i_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="100 trades, average +0.31R, SD ≈ 1.64R:&lt;br&gt;SE = 1.64 ÷ √100 = 0.164R&lt;br&gt;95% interval: +0.31R ± 0.33R → &lt;b&gt;−0.02R to +0.64R&lt;/b&gt;&lt;br&gt;&lt;br&gt;Zero is (just) inside: the edge looks good but isn&#39;t proven.&lt;br&gt;&lt;br&gt;Same average after 400 trades: ± 0.16R → +0.15R to +0.47R. Now the whole range is above zero.&lt;br&gt;&lt;br&gt;Win rate: 45 of 100 → 35% to 55%." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="i_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes when you turn a dial?" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="i_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;More trades&lt;/b&gt; (95%):&lt;br&gt;30 → −0.29R to +0.91R&lt;br&gt;100 → −0.02R to +0.64R&lt;br&gt;400 → +0.15R to +0.47R&lt;br&gt;&lt;br&gt;&lt;b&gt;More confidence&lt;/b&gt; (100 trades):&lt;br&gt;80% → +0.10R to +0.52R (misses 1 in 5)&lt;br&gt;95% → −0.02R to +0.64R&lt;br&gt;99% → −0.11R to +0.73R&lt;br&gt;&lt;br&gt;&lt;b&gt;Bumpier system:&lt;/b&gt; double the SD and the interval doubles in width." vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="i_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Misconception: &#39;95% chance it&#39;s in there&#39;" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="i_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;&#39;There&#39;s a 95% chance the truth is in my interval.&#39;&lt;/b&gt; Strictly, the truth is fixed and your interval either caught it or didn&#39;t. The 95% describes the recipe: it catches the truth in 19 of 20 samples.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;95% of my trades fall in the interval.&#39;&lt;/b&gt; No. The interval is for the &lt;i&gt;average&lt;/i&gt;. Single trades still range from −1R to +5R.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;Narrower is always better.&#39;&lt;/b&gt; An 80% interval is narrower only because it misses more often." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="i_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="i_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;CI = estimate ± z × SE&lt;/b&gt;&lt;br&gt;&lt;br&gt;SE of a mean = s ÷ √n (s = sample SD)&lt;br&gt;SE of a win rate = √(p(1 − p) ÷ n)&lt;br&gt;&lt;br&gt;z for 80%: 1.28 · 95%: 1.96 (≈ 2) · 99%: 2.58&lt;br&gt;&lt;br&gt;Expectancy: 0.31 ± 2 × 1.64 ÷ √100 = 0.31 ± 0.33&lt;br&gt;Win rate: 0.45 ± 2 × √(0.45 × 0.55 ÷ 100) = 0.45 ± 0.10&lt;br&gt;&lt;br&gt;Clears zero when 2 × s ÷ √n &amp;lt; average:&lt;br&gt;n &amp;gt; (2 × 1.64 ÷ 0.31)² ≈ 112" vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="i_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="i_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; your journal says +0.31R; other journals from the same system would say other things.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; 20 rings around a hidden peg; 19 catch it.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; your interval with more trades and different confidence levels; the zero test; win rate.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; three dials, the zero test, and the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="i_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="i_n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="Report a range, not a number: +0.31R ± 0.33R tells the truth that +0.31R hides." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
