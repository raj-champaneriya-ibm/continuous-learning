                <mxCell id="r_tavg1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" value="+0.25R" vertex="1">
                    <mxGeometry height="30" width="80" x="970" y="288" as="geometry"/>
                </mxCell>
                <mxCell id="r_tavg2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" value="+$125" vertex="1">
                    <mxGeometry height="30" width="95" x="1050" y="288" as="geometry"/>
                </mxCell>
                <mxCell id="r_tavg3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" value="0.30" vertex="1">
                    <mxGeometry height="30" width="80" x="1145" y="288" as="geometry"/>
                </mxCell>
                <mxCell id="r_t3a" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Same outcomes, three rules, three random variables. The win rate is just the average of the 1/0 rule." vertex="1">
                    <mxGeometry height="46" width="340" x="880" y="326" as="geometry"/>
                </mxCell>
                <mxCell id="r_d1T" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" value="Dial 1: double the size (1R = $1,000)" vertex="1">
                    <mxGeometry height="20" width="340" x="880" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="r_d1a" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" value="average per trade: +$125 → +$250" vertex="1">
                    <mxGeometry height="22" width="340" x="880" y="404" as="geometry"/>
                </mxCell>
                <mxCell id="r_d1b" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" value="typical swing (SD): ≈ $820 → ≈ $1,640" vertex="1">
                    <mxGeometry height="22" width="340" x="880" y="426" as="geometry"/>
                </mxCell>
                <mxCell id="r_d1c" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#7B1FA2;" value="edge in R: +0.25R → +0.25R (unchanged)" vertex="1">
                    <mxGeometry height="22" width="340" x="880" y="448" as="geometry"/>
                </mxCell>
                <mxCell id="r_d2T" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" value="Dial 2: shift 5% of trades from −1R to +5R" vertex="1">
                    <mxGeometry height="20" width="340" x="880" y="480" as="geometry"/>
                </mxCell>
                <mxCell id="r_d2a" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E7D32;" value="average: +0.25R → +0.55R" vertex="1">
                    <mxGeometry height="22" width="340" x="880" y="504" as="geometry"/>
                </mxCell>
                <mxCell id="r_t3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" value="The rule decides what you measure. The probabilities decide its shape." vertex="1">
                    <mxGeometry height="65" width="350" x="875" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="r_t3warn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="Pick the rule that answers your question. A 1/0 win flag alone hides how big the wins and losses are." vertex="1">
                    <mxGeometry height="90" width="350" x="875" y="617" as="geometry"/>
                </mxCell>
                <mxCell id="r_p4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6FBF4;strokeColor=#82b366;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="660" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="r_h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="4 · INSIGHT" vertex="1">
                    <mxGeometry height="44" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="r_i1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;" value="A &lt;b&gt;random variable&lt;/b&gt; is a rule that turns each outcome into a number. Its &lt;b&gt;distribution&lt;/b&gt; lists the values and how often each happens." vertex="1">
                    <mxGeometry height="80" width="350" x="1295" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="r_i2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Chapter 1&#39;s toolbox works on it" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="232" as="geometry"/>
                </mxCell>
                <mxCell id="r_rAvg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="AVERAGE" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="260" as="geometry"/>
                </mxCell>
                <mxCell id="r_rAvgT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Expectation = balance point of the distribution (+0.25R)" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="260" as="geometry"/>
                </mxCell>
                <mxCell id="r_rSpr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="SPREAD" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="304" as="geometry"/>
                </mxCell>
                <mxCell id="r_rSprT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Variance / SD = how wide it is (SD ≈ 1.64R)" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="304" as="geometry"/>
                </mxCell>
                <mxCell id="r_rShr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="SHARE" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="348" as="geometry"/>
                </mxCell>
                <mxCell id="r_rShrT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Probability = average of a 1/0 rule (win rate 30%)" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="348" as="geometry"/>
                </mxCell>
                <mxCell id="r_i3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Van Tharp&#39;s R is a random variable" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="396" as="geometry"/>
                </mxCell>
                <mxCell id="r_i3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" value="Measuring in R strips out position size, so you can compare systems and improve the edge separately from sizing." vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="421" as="geometry"/>
                </mxCell>
                <mxCell id="r_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#2E7D32;" value="Improve a system by reshaping its distribution: fewer −1R tags, more +5R tags." vertex="1">
                    <mxGeometry height="62" width="350" x="1295" y="477" as="geometry"/>
                </mxCell>
                <mxCell id="r_takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" value="Put a number on every outcome, and the whole toolbox (average, spread, odds) starts working on your trades." vertex="1">
                    <mxGeometry height="95" width="350" x="1295" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="r_next" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#5B8C46;" value="Next concept: Discrete and continuous distributions" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="r_e12" edge="1" parent="1" source="r_p1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="r_p2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_e23" edge="1" parent="1" source="r_p2" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="r_p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_e34" edge="1" parent="1" source="r_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="r_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="r_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="r_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="A &lt;b&gt;random variable&lt;/b&gt; is a rule that turns each random outcome into a number.&lt;br&gt;&lt;br&gt;That lets you do arithmetic on chance." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="r_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="r_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Outcomes are often words: heads, stopped out, trend day. You can&#39;t average words.&lt;br&gt;&lt;br&gt;A random variable attaches a number to every outcome. Once outcomes are numbers, you can average them (expectation), measure their spread (variance), and chart them (distribution).&lt;br&gt;&lt;br&gt;Different questions call for different rules on the same outcomes." vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="r_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual mental model: the price-tag machine" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="r_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Every outcome walks through the machine and comes out wearing a number:&lt;br&gt;stopped out → −1R&lt;br&gt;scratched → 0R&lt;br&gt;hit target → +2R&lt;br&gt;trailed out big → +5R&lt;br&gt;&lt;br&gt;&lt;b&gt;stack the outcomes on their numbers&lt;/b&gt;. 100 trades pile up as 50 · 20 · 25 · 5 above −1, 0, +2, +5. That stacked picture is the &lt;b&gt;distribution&lt;/b&gt;." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="r_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: two coins" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="r_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Flip two coins: HH, HT, TH, TT (each 1 in 4).&lt;br&gt;&lt;br&gt;&lt;b&gt;Rule X = number of heads:&lt;/b&gt;&lt;br&gt;HH → 2, HT → 1, TH → 1, TT → 0&lt;br&gt;Distribution: 0 → 1/4, 1 → 2/4, 2 → 1/4&lt;br&gt;&lt;br&gt;&lt;b&gt;Rule Y = 1 if the coins match, else 0:&lt;/b&gt;&lt;br&gt;HH → 1, TT → 1, HT → 0, TH → 0&lt;br&gt;Distribution: 0 → 1/2, 1 → 1/2&lt;br&gt;&lt;br&gt;Same outcomes, different questions, different random variables." vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="r_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="r_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Van Tharp&#39;s R-multiple is a random variable: result ÷ initial risk.&lt;br&gt;&lt;br&gt;stopped out (50%) → −1R&lt;br&gt;scratched (20%) → 0R&lt;br&gt;hit target (25%) → +2R&lt;br&gt;trailed out big (5%) → +5R&lt;br&gt;&lt;br&gt;Average: 0.5 × (−1) + 0.25 × 2 + 0.05 × 5 = &lt;b&gt;+0.25R&lt;/b&gt;&lt;br&gt;&lt;br&gt;Because R ignores position size, it measures the system itself." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="r_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes when you change the rule?" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="r_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Change the rule:&lt;/b&gt; R-multiple (average +0.25R), $ profit at 1R = $500 (average +$125), win flag 1/0 (average 0.30 = the win rate).&lt;br&gt;&lt;br&gt;&lt;b&gt;Change the size:&lt;/b&gt; at 1R = $1,000, the average becomes +$250 and the SD ≈ $1,640 (both double; variance ×4). The edge in R stays +0.25R.&lt;br&gt;&lt;br&gt;&lt;b&gt;Change the odds:&lt;/b&gt; move 5% of trades from −1R to +5R and the average rises from +0.25R to +0.55R." vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="r_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Misconception: &#39;it&#39;s a random number&#39;" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="r_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;&#39;A random variable is a random number.&#39;&lt;/b&gt; The rule itself is fixed and boring. The randomness is in which outcome happens.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;The number is the outcome.&#39;&lt;/b&gt; The outcome is what the market did. The number is one chosen way to measure it; another rule gives another number.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;Win rate is a different kind of thing.&#39;&lt;/b&gt; It is just the average of the 1/0 rule." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="r_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="r_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Ω = all outcomes&lt;br&gt;&lt;b&gt;X: Ω → numbers&lt;/b&gt; (a rule, that is, a function)&lt;br&gt;&lt;br&gt;P(X = x) = total chance of the outcomes tagged x&lt;br&gt;Distribution: all pairs (x, P(X = x)); the chances add to 1.&lt;br&gt;&lt;br&gt;E[X] = Σ x × P(X = x) = +0.25R&lt;br&gt;Indicator: E[1&lt;sub&gt;W&lt;/sub&gt;] = P(W) = 0.30&lt;br&gt;&lt;br&gt;Scaling: E[aX] = a × E[X], SD(aX) = |a| × SD(X)" vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="r_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="r_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; a journal written in words; words can&#39;t be averaged.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; the price-tag machine, then outcomes stacked into a distribution.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; three rules on the same trades; double the size; shift the odds.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; average, spread and share all live on a random variable; R as a random variable; the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="r_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="r_n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="Put a number on every outcome, and the whole toolbox (average, spread, odds) starts working on your trades." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="discrete-continuous" name="02 Discrete and Continuous">
