                </mxCell>
                <mxCell id="d_rg3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#B71C1C;" value="P(exactly +2.37R) = 0 (a line has no area)" vertex="1">
                    <mxGeometry height="22" width="340" x="880" y="526" as="geometry"/>
                </mxCell>
                <mxCell id="d_t3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" value="Same data, three pictures. Only area survives as the bins shrink." vertex="1">
                    <mxGeometry height="55" width="350" x="875" y="560" as="geometry"/>
                </mxCell>
                <mxCell id="d_t3warn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="Trailing-stop systems produce continuous R. Judge them by areas (especially the tail), not by single values." vertex="1">
                    <mxGeometry height="82" width="350" x="875" y="625" as="geometry"/>
                </mxCell>
                <mxCell id="d_p4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6FBF4;strokeColor=#82b366;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="660" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="d_h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="4 · INSIGHT" vertex="1">
                    <mxGeometry height="44" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="d_i1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;" value="&lt;b&gt;Discrete&lt;/b&gt;: values you count; chance sits on each value as a bar.&lt;br&gt;&lt;b&gt;Continuous&lt;/b&gt;: values you measure; chance is area over a range." vertex="1">
                    <mxGeometry height="85" width="350" x="1295" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="d_i2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Side by side" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="235" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpH0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;" value="" vertex="1">
