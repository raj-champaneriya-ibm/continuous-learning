                <mxCell id="d_cmpH1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;fontSize=11;fontStyle=1;" value="COUNTED" vertex="1">
                    <mxGeometry height="26" width="120" x="1405" y="262" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpH2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;fontSize=11;fontStyle=1;" value="MEASURED" vertex="1">
                    <mxGeometry height="26" width="120" x="1525" y="262" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpA0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;fontSize=10;fontStyle=1;" value="Picture" vertex="1">
                    <mxGeometry height="30" width="110" x="1295" y="288" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpA1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontSize=11;" value="bars (bricks)" vertex="1">
                    <mxGeometry height="30" width="120" x="1405" y="288" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpA2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontSize=11;" value="curve (sand)" vertex="1">
                    <mxGeometry height="30" width="120" x="1525" y="288" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpB0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;fontSize=10;fontStyle=1;" value="Chance of one value" vertex="1">
                    <mxGeometry height="30" width="110" x="1295" y="318" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpB1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontSize=11;" value="the bar&#39;s height" vertex="1">
                    <mxGeometry height="30" width="120" x="1405" y="318" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpB2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontSize=11;" value="zero" vertex="1">
                    <mxGeometry height="30" width="120" x="1525" y="318" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpC0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;fontSize=10;fontStyle=1;" value="Chance of a range" vertex="1">
                    <mxGeometry height="30" width="110" x="1295" y="348" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpC1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontSize=11;" value="add the bars" vertex="1">
                    <mxGeometry height="30" width="120" x="1405" y="348" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpC2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontSize=11;" value="area under the curve" vertex="1">
                    <mxGeometry height="30" width="120" x="1525" y="348" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpD0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;fontSize=10;fontStyle=1;" value="Trading example" vertex="1">
                    <mxGeometry height="30" width="110" x="1295" y="378" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpD1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontSize=11;" value="wins in 10 trades" vertex="1">
                    <mxGeometry height="30" width="120" x="1405" y="378" as="geometry"/>
                </mxCell>
                <mxCell id="d_cmpD2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontSize=11;" value="R with a trailing stop" vertex="1">
                    <mxGeometry height="30" width="120" x="1525" y="378" as="geometry"/>
                </mxCell>
                <mxCell id="d_i3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" value="The height of a curve is &lt;b&gt;density&lt;/b&gt; (chance per unit), not chance. Only area is probability." vertex="1">
                    <mxGeometry height="55" width="350" x="1295" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="d_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#2E7D32;" value="Van Tharp: study your R-multiple distribution, especially the area in the big-winner tail." vertex="1">
                    <mxGeometry height="58" width="350" x="1295" y="482" as="geometry"/>
                </mxCell>
                <mxCell id="d_takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" value="Count it? Add the bars.&lt;br&gt;Measure it? Measure the area." vertex="1">
                    <mxGeometry height="95" width="350" x="1295" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="d_next" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#5B8C46;" value="Next concept: Central limit theorem" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="d_e12" edge="1" parent="1" source="d_p1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="d_p2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="d_e23" edge="1" parent="1" source="d_p2" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="d_p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="d_e34" edge="1" parent="1" source="d_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="d_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="d_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="d_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="d_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Discrete&lt;/b&gt; random variables take countable values; probability sits on each value.&lt;br&gt;&lt;br&gt;&lt;b&gt;Continuous&lt;/b&gt; random variables can take any value in a range; probability is the area over an interval, never at a single point." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="d_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="d_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Some trading numbers are counted: wins this week, trades today, losses in a row. Others are measured: hold time, slippage, the exact R of a trailing-stop exit.&lt;br&gt;&lt;br&gt;For counted things you can ask &lt;i&gt;what&#39;s the chance of exactly 3?&lt;/i&gt; For measured things, the chance of any exact value (say +2.37000…R) is zero, so the useful question becomes &lt;i&gt;what&#39;s the chance of landing in this range?&lt;/i&gt;" vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="d_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual mental model: bricks vs sand" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="d_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Discrete:&lt;/b&gt; bricks stacked on specific spots. A brick&#39;s height is the chance of that spot.&lt;br&gt;&lt;br&gt;&lt;b&gt;Continuous:&lt;/b&gt; sand spread along a line. The amount of sand over a stretch is the chance of that stretch. A single point has no width, so it holds no sand.&lt;br&gt;&lt;br&gt;&lt;b&gt;shrink the bins&lt;/b&gt;. Narrow bars become a smooth curve, and probability becomes the area under it." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="d_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: wins vs hold time" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="d_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Discrete:&lt;/b&gt; wins in 4 trades of a 50/50 system: 0, 1, 2, 3, 4 with chances 1, 4, 6, 4, 1 out of 16.&lt;br&gt;P(2 or 3 wins) = 10/16&lt;br&gt;&lt;br&gt;&lt;b&gt;Continuous:&lt;/b&gt; hold time, equally likely anywhere from 0 to 60 minutes. Height = 1/60 per minute.&lt;br&gt;P(10 to 25 min) = 15 × 1/60 = 25%&lt;br&gt;P(exactly 40:00.000) = 0" vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="d_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="d_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Fixed stop and fixed target: R takes only a few values (−1R, +2R), so it is discrete.&lt;br&gt;&lt;br&gt;Trailing stops: R can be anything (+0.4R, +2.37R, +6.1R), so treat it as continuous. Chart it as a histogram and read areas:&lt;br&gt;• above +3R: 8%&lt;br&gt;• between +1R and +3R: 22%&lt;br&gt;&lt;br&gt;Van Tharp: the big-winner tail often pays for the whole system. Measure its area, and protect it." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="d_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes when the bins shrink?" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="d_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Shrink the bins&lt;/b&gt; (1R → ½R → smooth): each bar gets narrower and holds less probability, but the area over any range stays the same (8% above +3R).&lt;br&gt;&lt;br&gt;&lt;b&gt;Widen the range:&lt;/b&gt; more area, more probability (above +3R: 8%; above +1R: 30%).&lt;br&gt;&lt;br&gt;&lt;b&gt;Shrink the range to a point:&lt;/b&gt; the area goes to 0." vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="d_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Misconception: &#39;height = probability&#39;" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="d_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;&#39;The height of the curve is the probability.&#39;&lt;/b&gt; Height is &lt;i&gt;density&lt;/i&gt;: chance per unit. It can even exceed 1: hold time spread evenly over 0 to ½ hour has a height of 2 per hour. Only area is probability.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;Probability 0 means impossible.&#39;&lt;/b&gt; Every exact value of a continuous variable has probability 0, yet some value always happens. Zero here means &#39;too thin to hold any area&#39;." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="d_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="d_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Discrete&lt;/b&gt; (probability mass function):&lt;br&gt;p(x) = P(X = x), and Σ p(x) = 1&lt;br&gt;P(a ≤ X ≤ b) = sum of the bars from a to b&lt;br&gt;&lt;br&gt;&lt;b&gt;Continuous&lt;/b&gt; (probability density function):&lt;br&gt;f(x) ≥ 0, total area = 1&lt;br&gt;P(a ≤ X ≤ b) = ∫ from a to b of f(x) dx (∫ just means &#39;area&#39;)&lt;br&gt;P(X = a) = 0&lt;br&gt;&lt;br&gt;Uniform hold time: f = 1/60 per minute on [0, 60]&lt;br&gt;P(10 ≤ T ≤ 25) = 15 × 1/60 = 0.25" vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="d_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="d_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; counted vs measured numbers in a journal, and the &#39;exactly +2.37R&#39; puzzle.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; bricks on spots vs sand along a line; a point holds no sand.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; shrink the bins from 1R to ½R to a curve; the tail area stays 8%.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; side-by-side comparison, density vs probability, and the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="d_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="d_n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="Count it? Add the bars.&lt;br&gt;Measure it? Measure the area." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>