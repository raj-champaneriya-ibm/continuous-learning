                    <mxGeometry height="44" width="380" x="20" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="d_t1a" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Two kinds of numbers in your journal" vertex="1">
                    <mxGeometry height="24" width="354" x="33" y="135" as="geometry"/>
                </mxCell>
                <mxCell id="d_hC" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="COUNTED · whole numbers" vertex="1">
                    <mxGeometry height="24" width="165" x="40" y="168" as="geometry"/>
                </mxCell>
                <mxCell id="d_hM" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" value="MEASURED · any value" vertex="1">
                    <mxGeometry height="24" width="165" x="215" y="168" as="geometry"/>
                </mxCell>
                <mxCell id="d_c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=12;" value="wins this week: 3" vertex="1">
                    <mxGeometry height="32" width="165" x="40" y="198" as="geometry"/>
                </mxCell>
                <mxCell id="d_c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=12;" value="trades today: 2" vertex="1">
                    <mxGeometry height="32" width="165" x="40" y="236" as="geometry"/>
                </mxCell>
                <mxCell id="d_c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=12;" value="losses in a row: 4" vertex="1">
                    <mxGeometry height="32" width="165" x="40" y="274" as="geometry"/>
                </mxCell>
