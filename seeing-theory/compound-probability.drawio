                <mxCell id="s_notW" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;" value="W" vertex="1">
                    <mxGeometry height="30" width="14" x="984" y="325" as="geometry"/>
                </mxCell>
                <mxCell id="s_notL" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;" value="L" vertex="1">
                    <mxGeometry height="30" width="14" x="984" y="355" as="geometry"/>
                </mxCell>
                <mxCell id="s_notTL" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontSize=11;fontColor=#9E9E9E;" value="30" vertex="1">
                    <mxGeometry height="30" width="50" x="1000" y="325" as="geometry"/>
                </mxCell>
                <mxCell id="s_notTR" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontSize=11;fontColor=#9E9E9E;" value="15" vertex="1">
                    <mxGeometry height="30" width="50" x="1050" y="325" as="geometry"/>
                </mxCell>
                <mxCell id="s_notBL" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="10" vertex="1">
                    <mxGeometry height="30" width="50" x="1000" y="355" as="geometry"/>
                </mxCell>
                <mxCell id="s_notBR" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="45" vertex="1">
                    <mxGeometry height="30" width="50" x="1050" y="355" as="geometry"/>
                </mxCell>
                <mxCell id="s_notRes" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" value="everything outside W:&lt;br&gt;100 − 45 = 55" vertex="1">
                    <mxGeometry height="60" width="125" x="1110" y="325" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcT" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" value="Why 40 + 45 is wrong" vertex="1">
                    <mxGeometry height="20" width="340" x="880" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcLbl" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" value="T column (40)&lt;br&gt;+ W row (45)&lt;br&gt;= 85" vertex="1">
                    <mxGeometry height="60" width="105" x="875" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcTL" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;strokeWidth=2;fontSize=11;fontStyle=1;" value="30 ×2" vertex="1">
                    <mxGeometry height="30" width="50" x="1000" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcTR" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="15" vertex="1">
                    <mxGeometry height="30" width="50" x="1050" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcBL" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="10" vertex="1">
                    <mxGeometry height="30" width="50" x="1000" y="455" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcBR" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontSize=11;fontColor=#9E9E9E;" value="45" vertex="1">
                    <mxGeometry height="30" width="50" x="1050" y="455" as="geometry"/>
                </mxCell>
                <mxCell id="s_dcRes" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#E65100;" value="the overlap box was counted twice:&lt;br&gt;85 − 30 = 55" vertex="1">
                    <mxGeometry height="60" width="125" x="1110" y="425" as="geometry"/>
                </mxCell>
                <mxCell id="s_slT" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" value="Slide the circles: the overlap sets the OR count" vertex="1">
                    <mxGeometry height="20" width="340" x="880" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="s_v1T" parent="1" style="ellipse;html=1;fillColor=#7EA6E0;fillOpacity=45;strokeColor=#6c8ebf;" value="" vertex="1">
                    <mxGeometry height="40" width="40" x="892" y="533" as="geometry"/>
                </mxCell>
                <mxCell id="s_v1W" parent="1" style="ellipse;html=1;fillColor=#97D077;fillOpacity=45;strokeColor=#82b366;" value="" vertex="1">
                    <mxGeometry height="40" width="40" x="942" y="533" as="geometry"/>
                </mxCell>
                <mxCell id="s_v2T" parent="1" style="ellipse;html=1;fillColor=#7EA6E0;fillOpacity=45;strokeColor=#6c8ebf;" value="" vertex="1">
                    <mxGeometry height="40" width="40" x="1015" y="533" as="geometry"/>
                </mxCell>
                <mxCell id="s_v2W" parent="1" style="ellipse;html=1;fillColor=#97D077;fillOpacity=45;strokeColor=#82b366;" value="" vertex="1">
                    <mxGeometry height="40" width="40" x="1040" y="533" as="geometry"/>
                </mxCell>
                <mxCell id="s_v3W" parent="1" style="ellipse;html=1;fillColor=#97D077;fillOpacity=45;strokeColor=#82b366;" value="" vertex="1">
                    <mxGeometry height="52" width="52" x="1139" y="527" as="geometry"/>
                </mxCell>
                <mxCell id="s_v3T" parent="1" style="ellipse;html=1;fillColor=#7EA6E0;fillOpacity=45;strokeColor=#6c8ebf;" value="" vertex="1">
                    <mxGeometry height="30" width="30" x="1150" y="538" as="geometry"/>
                </mxCell>
                <mxCell id="s_v1Lbl" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;" value="apart (overlap 0)&lt;br&gt;&lt;b&gt;OR = 85&lt;/b&gt;" vertex="1">
                    <mxGeometry height="32" width="110" x="882" y="583" as="geometry"/>
                </mxCell>
                <mxCell id="s_v2Lbl" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;" value="overlap 30&lt;br&gt;&lt;b&gt;OR = 55&lt;/b&gt;" vertex="1">
                    <mxGeometry height="32" width="110" x="992" y="583" as="geometry"/>
                </mxCell>
                <mxCell id="s_v3Lbl" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;" value="T inside W (overlap 40)&lt;br&gt;&lt;b&gt;OR = 45&lt;/b&gt;" vertex="1">
                    <mxGeometry height="32" width="125" x="1103" y="583" as="geometry"/>
                </mxCell>
                <mxCell id="s_t3warn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="Bigger overlap → smaller OR count. Only when the circles don&#39;t touch can you simply add." vertex="1">
                    <mxGeometry height="80" width="350" x="875" y="627" as="geometry"/>
                </mxCell>
                <mxCell id="s_p4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6FBF4;strokeColor=#82b366;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="660" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="s_h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="4 · INSIGHT" vertex="1">
                    <mxGeometry height="44" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="s_i1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;" value="An &lt;b&gt;event&lt;/b&gt; is a group of outcomes: a circle in the box. Combine groups with three words: &lt;b&gt;AND&lt;/b&gt;, &lt;b&gt;OR&lt;/b&gt;, &lt;b&gt;NOT&lt;/b&gt;." vertex="1">
                    <mxGeometry height="80" width="350" x="1295" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="s_rAnd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=13;fontStyle=1;" value="AND" vertex="1">
                    <mxGeometry height="36" width="70" x="1295" y="235" as="geometry"/>
                </mxCell>
                <mxCell id="s_rAndT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="only the overlap box (it can only shrink)" vertex="1">
                    <mxGeometry height="36" width="273" x="1372" y="235" as="geometry"/>
                </mxCell>
                <mxCell id="s_rOr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=13;fontStyle=1;" value="OR" vertex="1">
                    <mxGeometry height="36" width="70" x="1295" y="281" as="geometry"/>
                </mxCell>
                <mxCell id="s_rOrT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="add both groups, then subtract the overlap once" vertex="1">
                    <mxGeometry height="36" width="273" x="1372" y="281" as="geometry"/>
                </mxCell>
                <mxCell id="s_rNot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=13;fontStyle=1;" value="NOT" vertex="1">
                    <mxGeometry height="36" width="70" x="1295" y="327" as="geometry"/>
                </mxCell>
                <mxCell id="s_rNotT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="everything outside the circle: the whole box minus the group" vertex="1">
                    <mxGeometry height="36" width="273" x="1372" y="327" as="geometry"/>
                </mxCell>
                <mxCell id="s_i3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Bonus: the four-box exposes an edge" vertex="1">
                    <mxGeometry height="24" width="350" x="1295" y="378" as="geometry"/>
                </mxCell>
                <mxCell id="s_edgeT" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" value="Trend days: 30 wins of 40 = 75%" vertex="1">
                    <mxGeometry height="30" width="350" x="1295" y="406" as="geometry"/>
                </mxCell>
                <mxCell id="s_edgeN" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" value="Other days: 15 wins of 60 = 25%" vertex="1">
                    <mxGeometry height="30" width="350" x="1295" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="s_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#2E7D32;" value="Van Tharp-style improvement: tag every trade, then slice the journal to find where the edge really lives." vertex="1">
                    <mxGeometry height="60" width="350" x="1295" y="477" as="geometry"/>
                </mxCell>
                <mxCell id="s_takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" value="Draw the four-box before you add, and never count the overlap twice." vertex="1">
                    <mxGeometry height="95" width="350" x="1295" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="s_next" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#5B8C46;" value="Next concept: Counting. (The 75% vs 25% returns in Conditional probability.)" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="s_e12" edge="1" parent="1" source="s_p1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="s_p2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s_e23" edge="1" parent="1" source="s_p2" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="s_p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s_e34" edge="1" parent="1" source="s_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="s_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="s_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="s_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="An &lt;b&gt;event&lt;/b&gt; is a group of possible outcomes.&lt;br&gt;&lt;br&gt;You can combine groups with &lt;b&gt;AND&lt;/b&gt;, &lt;b&gt;OR&lt;/b&gt;, and &lt;b&gt;NOT&lt;/b&gt;, as long as you never count the overlap twice." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="s_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="s_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Real questions are compound: &lt;i&gt;a trend day AND a winner&lt;/i&gt;, &lt;i&gt;a winner OR a breakeven&lt;/i&gt;, &lt;i&gt;NOT a loss&lt;/i&gt;.&lt;br&gt;&lt;br&gt;Set theory gives a clean way to describe and combine those groups. Its main job is bookkeeping: making sure every outcome is counted exactly once.&lt;br&gt;&lt;br&gt;The classic error it prevents is double-counting the outcomes that belong to both groups." vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="s_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual mental model: circles, then a four-box" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="s_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Draw a box for everything that can happen (all 100 trades). Each tag draws a circle inside the box. Circles can overlap.&lt;br&gt;&lt;br&gt;unfold the circles into a &lt;b&gt;four-box&lt;/b&gt; (a 2 × 2 table):&lt;br&gt;trend · win = 30 &amp;nbsp; not trend · win = 15&lt;br&gt;trend · loss = 10 &amp;nbsp; not trend · loss = 45&lt;br&gt;&lt;br&gt;Every trade lives in exactly one box, so nothing can be counted twice." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="s_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: a deck of cards" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="s_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="A deck has 52 cards: 26 red cards and 4 kings.&lt;br&gt;&lt;br&gt;&lt;b&gt;Red OR king?&lt;/b&gt; Not 26 + 4 = 30. The 2 red kings sit in both groups, so they were counted twice.&lt;br&gt;26 + 4 − 2 = &lt;b&gt;28 cards&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Red AND king&lt;/b&gt; = 2 cards&lt;br&gt;&lt;b&gt;NOT red&lt;/b&gt; = 52 − 26 = 26 cards" vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="s_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="s_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Your journal is the box. Each tag (trend day, setup type, session, win) is a circle.&lt;br&gt;&lt;br&gt;100 trades: 40 on trend days, 45 winners, 30 both.&lt;br&gt;• trend AND win = 30&lt;br&gt;• trend OR win = 40 + 45 − 30 = 55&lt;br&gt;• NOT win = 55 losses&lt;br&gt;&lt;br&gt;Slice by AND and an edge appears: trend days win 30 of 40 (75%); other days win 15 of 60 (25%). Van Tharp-style improvement starts with this kind of slicing." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="s_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes when the overlap changes?" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="s_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Keep T = 40 and W = 45, and slide the circles:&lt;br&gt;&lt;br&gt;apart (overlap 0) → OR = 85&lt;br&gt;overlap 30 → OR = 55&lt;br&gt;T inside W (overlap 40) → OR = 45&lt;br&gt;&lt;br&gt;&lt;b&gt;Bigger overlap → smaller OR count.&lt;/b&gt; The overlap can never exceed the smaller group (40).&lt;br&gt;&lt;br&gt;Only when the circles don&#39;t touch (mutually exclusive events, like win vs loss on the same trade) can you simply add." vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="s_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Misconception: &#39;OR means add&#39;" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="s_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;&#39;OR means add.&#39;&lt;/b&gt; Only if the groups don&#39;t overlap. Otherwise the shared outcomes are counted twice.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;OR means one or the other, not both.&#39;&lt;/b&gt; In everyday speech, maybe. In probability, OR includes both.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;AND can be bigger than either group.&#39;&lt;/b&gt; AND can only shrink: trend AND win (30) is smaller than trend (40) and smaller than win (45)." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="s_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="s_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Ω = all outcomes (the box)&lt;br&gt;Event = a subset of Ω (a circle): T, W&lt;br&gt;&lt;br&gt;T ∪ W = T OR W (union)&lt;br&gt;T ∩ W = T AND W (intersection)&lt;br&gt;Wᶜ = NOT W (complement)&lt;br&gt;&lt;br&gt;&lt;b&gt;P(T ∪ W) = P(T) + P(W) − P(T ∩ W)&lt;/b&gt;&lt;br&gt;= 0.40 + 0.45 − 0.30 = 0.55&lt;br&gt;&lt;br&gt;&lt;b&gt;P(Wᶜ) = 1 − P(W)&lt;/b&gt; = 0.55&lt;br&gt;&lt;br&gt;If T ∩ W is empty: P(T ∪ W) = P(T) + P(W)" vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="s_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="s_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; a tagged trade journal and the tempting 40 + 45 = 85.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; circles in a box, unfolded into a four-box.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; shade the four-box for AND, OR, NOT; see the double count; slide the circles.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; three rules, the hidden 75% vs 25% edge, and the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="s_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
