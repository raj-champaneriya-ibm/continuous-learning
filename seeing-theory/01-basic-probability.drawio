                <mxCell id="x_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="x_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="x_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Expectation is &lt;b&gt;what one draw is worth on average&lt;/b&gt; if you could repeat it forever." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="x_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="x_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Win rate tells you &lt;b&gt;how often&lt;/b&gt;. It says nothing about &lt;b&gt;how much&lt;/b&gt;.&lt;br&gt;&lt;br&gt;A system can win 90% of the time and still lose money; another can win 30% of the time and make plenty.&lt;br&gt;&lt;br&gt;Expectation fixes this by combining how often and how much into one number: the average payoff per trade in the long run." vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="x_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual model: level the pile" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="x_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Write a payoff on every marble. System B&#39;s bag: three +4R and seven −1R.&lt;br&gt;&lt;br&gt;&lt;div&gt;move, &lt;b&gt;cancel then share&lt;/b&gt;:&lt;br&gt;greens add to +12R, reds to −7R&lt;br&gt;cancel → +5R left over&lt;br&gt;share across 10 marbles → +0.5R each&lt;br&gt;&lt;br&gt;Picture stacks of coins of different heights. Level them until every stack is the same height. That height is the expectation.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="x_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: a die that pays" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="x_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="A die pays $1 to $6, whatever you roll.&lt;br&gt;&lt;br&gt;Pair opposite faces:&lt;br&gt;1 + 6 = 7&lt;br&gt;2 + 5 = 7&lt;br&gt;3 + 4 = 7&lt;br&gt;Three pairs = $21 spread over 6 faces → &lt;b&gt;$3.50 per roll&lt;/b&gt;.&lt;br&gt;&lt;br&gt;You can never roll a 3.5. The expectation does not have to be a possible outcome; it&#39;s the long-run average." vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="x_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="x_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Van Tharp measures every result in &lt;b&gt;R&lt;/b&gt;, a multiple of what you risked. Expectancy is the average R per trade.&lt;br&gt;&lt;br&gt;&lt;b&gt;System A:&lt;/b&gt; 9 wins of +0.5R, 1 loss of −6R → −1.5R per 10 trades → &lt;b&gt;−0.15R per trade&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;System B:&lt;/b&gt; 3 wins of +4R, 7 losses of −1R → +5R per 10 trades → &lt;b&gt;+0.5R per trade&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Over 100 trades: A ≈ −15R, B ≈ +50R." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="x_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes: the dials" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="x_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Win size&lt;/b&gt; (40% wins, −1R losses):&lt;br&gt;+1R → −0.2R · +1.5R → 0 (break-even)&lt;br&gt;+2R → +0.2R · +3R → +0.6R&lt;br&gt;&lt;br&gt;&lt;b&gt;Win rate&lt;/b&gt; (+2R wins, −1R losses):&lt;br&gt;20% → −0.4R · 30% → −0.1R&lt;br&gt;33% → ≈ 0 · 40% → +0.2R · 50% → +0.5R&lt;br&gt;&lt;br&gt;&lt;b&gt;Improving System B:&lt;/b&gt;&lt;br&gt;winners +4R → +5R: +0.5R → +0.8R&lt;br&gt;losses −1R → −0.5R: +0.5R → +0.85R" vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="x_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Common misconceptions" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="x_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="System A wins 90% of the time and still loses money: one big loss outweighs nine small wins.&lt;br&gt;&lt;br&gt;Second trap, the word &lt;i&gt;expected&lt;/i&gt;: B&#39;s next trade will be +4R or −1R, never +0.5R. Expectation describes the long run, not the next trade.&lt;br&gt;&lt;br&gt;And over just 10 trades, B still finishes behind about 1 time in 7." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="x_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="x_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="For every kind of marble, multiply its value by its chance, then add:&lt;br&gt;&lt;br&gt;&lt;b&gt;E[X] = Σ value × P(value)&lt;/b&gt;&lt;br&gt;&lt;br&gt;System B:&lt;br&gt;0.3 × (+4R) + 0.7 × (−1R) = 1.2 − 0.7 = +0.5R&lt;br&gt;&lt;br&gt;Die:&lt;br&gt;(1 + 2 + 3 + 4 + 5 + 6) ÷ 6 = 3.5&lt;br&gt;&lt;br&gt;Link to Chance Events: the average of many trades settles on E[X]. This is the law of large numbers." vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="x_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="x_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; two 10-trade strips where bar height = result in R; 90% winner vs 30% winner.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; System B&#39;s bag, cancel then share → +0.5R.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; 100-trade totals, then the win-size dial around break-even.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; improve the marbles, measure in R, and the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="x_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="x_n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="Don&#39;t ask how often a system wins. Ask what each trade is worth on average." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
