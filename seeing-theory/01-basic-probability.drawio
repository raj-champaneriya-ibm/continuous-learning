                <mxCell id="x_i3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" value="&lt;b&gt;Van Tharp&#39;s R:&lt;/b&gt; measure every result as a multiple of what you risked. Expectancy = the average R per trade." vertex="1">
                    <mxGeometry height="65" width="350" x="1295" y="372" as="geometry"/>
                </mxCell>
                <mxCell id="x_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=3;fontColor=#2E7D32;" value="+0.5R per trade × 100 trades ≈ +50R.&lt;br&gt;Expectancy is the engine; the number of trades is the fuel." vertex="1">
                    <mxGeometry height="80" width="350" x="1295" y="448" as="geometry"/>
                </mxCell>
                <mxCell id="x_takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" value="Don&#39;t ask &#39;how often do I win?&#39;&lt;br&gt;Ask &#39;what is each trade worth on average?&#39;" vertex="1">
