                <mxCell id="k5" parent="1" style="rounded=1;html=1;fillColor=#E57373;strokeColor=#B71C1C;" value="" vertex="1">
                    <mxGeometry height="24" width="24" x="1412" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="kPlus" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" value="+ 95 ordinary trades" vertex="1">
                    <mxGeometry height="24" width="115" x="1442" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="kRes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" value="≈ 38% overall" vertex="1">
                    <mxGeometry height="34" width="75" x="1572" y="445" as="geometry"/>
                </mxCell>
                <mxCell id="e_k" edge="1" parent="1" source="kPlus" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;" target="kRes">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=3;fontColor=#2E7D32;" value="The long run doesn&#39;t correct streaks. It drowns them." vertex="1">
                    <mxGeometry height="40" width="350" x="1295" y="490" as="geometry"/>
                </mxCell>
                <mxCell id="takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=17;fontStyle=1;" value="Judge a system by its 100th trade, not its last one." vertex="1">
                    <mxGeometry height="90" width="350" x="1295" y="550" as="geometry"/>
                </mxCell>
                <mxCell id="next" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#5B8C46;" value="Next concept: Expectation (what each marble is worth)" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="e12" edge="1" parent="1" source="p1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e23" edge="1" parent="1" source="p2" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e34" edge="1" parent="1" source="p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="A probability tells you &lt;b&gt;how often&lt;/b&gt; something happens when the same situation repeats many times.&lt;br&gt;&lt;br&gt;It tells you nothing certain about the next try." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="You can&#39;t predict one coin flip or one trade. Look at a thousand of them and a steady pattern appears.&lt;br&gt;&lt;br&gt;Probability answers one question: &lt;i&gt;what can we reliably know about something that is unpredictable one event at a time?&lt;/i&gt;&lt;br&gt;&lt;br&gt;The answer is the pattern across many repeats. Single events are noise; the crowd of events is the signal." vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual model: the marble bag" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Van Tharp&#39;s device: your system is a bag of 10 marbles, laid out as a ten-frame (Greg Tang grouping): &lt;b&gt;4 green&lt;/b&gt; (win) and &lt;b&gt;6 red&lt;/b&gt; (loss).&lt;br&gt;&lt;br&gt;&lt;b&gt;One trade&lt;/b&gt; = draw one marble, write W or L, put it back.&lt;br&gt;&lt;br&gt;The bag never changes and never remembers.&lt;br&gt;&lt;br&gt;Probability of a win = share of green in the bag = 4 of 10.&lt;br&gt;&lt;br&gt;&lt;i&gt;Catch: in real trading you never see inside the bag. You only see the draws.&lt;/i&gt;" vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: coin flips" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Track the share of heads from a fair coin (one run):&lt;br&gt;&lt;br&gt;10 flips → 7 heads → 70%&lt;br&gt;100 flips → 54 heads → 54%&lt;br&gt;1,000 flips → 503 heads → 50.3%&lt;br&gt;&lt;br&gt;The coin was 50/50 the whole time. Short runs wander; long runs settle near 50%." vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Last 10 trades: W L L L L L W L W L. That&#39;s 3 wins and a streak of 5 losses. The urge: &lt;i&gt;&#39;the system is broken, change it.&#39;&lt;/i&gt;&lt;br&gt;&lt;br&gt;A true 40% bag easily gives anywhere from 1 to 7 wins in 10 draws, so 3 of 10 is ordinary. Changing the system now is reacting to noise.&lt;br&gt;&lt;br&gt;Van Tharp: judge a system on roughly 100 trades. Real improvement changes the bag, not your reaction to the last few draws." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes: more draws" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Same 40% bag. Range of win rates you&#39;d see 19 times out of 20:&lt;br&gt;&lt;br&gt;10 trades → 10% to 70%&lt;br&gt;100 trades → 30% to 50%&lt;br&gt;1,000 trades → 37% to 43%&lt;br&gt;&lt;br&gt;The wobble shrinks slowly:&lt;br&gt;100 trades → ±10%&lt;br&gt;400 trades → ±5%&lt;br&gt;1,600 trades → ±2.5%&lt;br&gt;&lt;br&gt;&lt;b&gt;Halving the wobble costs 4× the trades.&lt;/b&gt;" vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Common misconceptions" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="After 5 losses, the next trade is &lt;b&gt;not&lt;/b&gt; more likely to win. The marble went back in; the next draw is still 4 in 10.&lt;br&gt;&lt;br&gt;The law of averages doesn&#39;t correct streaks. It &lt;b&gt;drowns&lt;/b&gt; them: 5 losses + 95 ordinary trades ≈ 38 wins in 100 = 38%. Close to 40%, with no payback.&lt;br&gt;&lt;br&gt;Streaks are normal: at 40% wins, a run of 5+ losses shows up in almost every 100-trade stretch." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Event:&lt;/b&gt; A = &#39;this trade wins&#39;&lt;br&gt;&lt;br&gt;&lt;b&gt;Probability as a long-run share:&lt;/b&gt;&lt;br&gt;P(A) ≈ wins ÷ trades&lt;br&gt;It gets closer to the bag&#39;s true share as the number of trades grows. Always between 0 (never) and 1 (always).&lt;br&gt;&lt;br&gt;&lt;b&gt;Size of the wobble:&lt;/b&gt;&lt;br&gt;wobble ≈ √( p(1 − p) ÷ n ), where n = number of trades&lt;br&gt;Square root ⇒ 4× the trades = ½ the wobble. The ranges in card 6 are about 2 wobbles either side of 40%." vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; a 10-trade streak and the doubt it creates.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; the marble bag; draw, record, put back.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; 10 / 100 / 1,000-trade ranges against the true 40%.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; the shrinking wobble, the drowned streak, and the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="One trade tells you nothing. The truth about a system only shows up in the crowd of trades, so judge it by its 100th trade, not its last one." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
