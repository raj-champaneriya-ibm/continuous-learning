                <mxCell id="v_p4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6FBF4;strokeColor=#82b366;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="660" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="v_h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="4 · INSIGHT" vertex="1">
                    <mxGeometry height="44" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="v_i1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;" value="&lt;b&gt;Variance&lt;/b&gt; = how far results land from the average, on average.&lt;br&gt;Expectation says where you end up. Variance says how bumpy the road is." vertex="1">
                    <mxGeometry height="85" width="350" x="1295" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="v_i2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Same edge (+0.5R), different ride:" vertex="1">
                    <mxGeometry height="24" width="350" x="1295" y="235" as="geometry"/>
                </mxCell>
                <mxCell id="v_r1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" value="5 × +2R, 5 × −1R (Steady)" vertex="1">
                    <mxGeometry height="28" width="215" x="1295" y="265" as="geometry"/>
                </mxCell>
                <mxCell id="v_r1v" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" value="SD 1.5R" vertex="1">
                    <mxGeometry height="28" width="125" x="1520" y="265" as="geometry"/>
                </mxCell>
                <mxCell id="v_r2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" value="3 × +4R, 7 × −1R (System B)" vertex="1">
                    <mxGeometry height="28" width="215" x="1295" y="299" as="geometry"/>
                </mxCell>
                <mxCell id="v_r2v" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" value="SD 2.3R" vertex="1">
                    <mxGeometry height="28" width="125" x="1520" y="299" as="geometry"/>
                </mxCell>
                <mxCell id="v_r3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" value="1 × +14R, 9 × −1R (Wild)" vertex="1">
                    <mxGeometry height="28" width="215" x="1295" y="333" as="geometry"/>
                </mxCell>
                <mxCell id="v_r3v" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" value="SD 4.5R" vertex="1">
                    <mxGeometry height="28" width="125" x="1520" y="333" as="geometry"/>
                </mxCell>
                <mxCell id="v_i3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" value="&lt;b&gt;Edge per unit of bumpiness&lt;/b&gt; (expectancy ÷ SD), the heart of Van Tharp&#39;s SQN:&lt;br&gt;Steady 0.33 · B 0.22 · Wild 0.11" vertex="1">
                    <mxGeometry height="70" width="350" x="1295" y="372" as="geometry"/>
                </mxCell>
                <mxCell id="v_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#2E7D32;" value="Two ways to improve a system: raise the average, or shrink the bumpiness. The bumpiness decides how much you can safely risk per trade." vertex="1">
                    <mxGeometry height="85" width="350" x="1295" y="448" as="geometry"/>
                </mxCell>
                <mxCell id="v_takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" value="The average says where you&#39;ll end up. The variance says whether you&#39;ll survive the trip." vertex="1">
                    <mxGeometry height="95" width="350" x="1295" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="v_next" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#5B8C46;" value="Next concept: Set theory (combining events)" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="v_e12" edge="1" parent="1" source="v_p1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="v_p2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v_e23" edge="1" parent="1" source="v_p2" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="v_p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v_e34" edge="1" parent="1" source="v_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="v_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="v_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="v_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Variance measures &lt;b&gt;how far results typically land from the average&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Same average, different bumpiness." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="v_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="v_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Expectation tells you where you end up on average. It says nothing about the ride.&lt;br&gt;&lt;br&gt;Two systems can share the same expectancy and still feel completely different: one steady, one wild. The wild one brings deeper drawdowns and longer losing streaks, which is where traders quit or blow up.&lt;br&gt;&lt;br&gt;Variance puts a number on that bumpiness." vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="v_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual model: strings → squares" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="v_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Tie every marble to the average line with a string. Short strings = steady; long strings = wild.&lt;br&gt;&lt;br&gt;Turn each string into a &lt;b&gt;square&lt;/b&gt; whose side is the string&#39;s length. The area of the average square is the &lt;b&gt;variance&lt;/b&gt;. The side of that average square is the &lt;b&gt;standard deviation (SD)&lt;/b&gt;, back in R.&lt;br&gt;&lt;br&gt;Steady: ten 1.5R strings.&lt;br&gt;Wild: nine 1.5R strings and one 13.5R string, whose giant square holds 90% of all the area." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="v_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: two routes" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="v_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Both routes average 30 minutes.&lt;br&gt;&lt;br&gt;Route 1: 28, 30, 32 min → strings 2, 0, 2&lt;br&gt;Route 2: 15, 30, 45 min → strings 15, 0, 15&lt;br&gt;&lt;br&gt;Squares: 4, 0, 4 vs 225, 0, 225&lt;br&gt;Average square: ≈ 2.7 vs 150&lt;br&gt;SD: ≈ 1.6 min vs ≈ 12.2 min&lt;br&gt;&lt;br&gt;Same average. Only Route 2 makes you late for the meeting." vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="v_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="v_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Two bags, both +0.5R per trade:&lt;br&gt;&lt;b&gt;Steady:&lt;/b&gt; 5 × +2R, 5 × −1R&lt;br&gt;&lt;b&gt;Wild:&lt;/b&gt; 1 × +14R, 9 × −1R&lt;br&gt;&lt;br&gt;Over 100 trades both expect +50R, but:&lt;br&gt;• typical longest losing streak: Steady ≈ 6, Wild ≈ 20&lt;br&gt;• still losing after 100 trades: Steady almost never, Wild about 1 time in 8&lt;br&gt;&lt;br&gt;Van Tharp: the bumpier the system, the smaller the risk per trade must be to survive its drawdowns." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="v_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes: payoff shape" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="v_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Keep expectancy at +0.5R and reshape the bag:&lt;br&gt;&lt;br&gt;5 × +2R / 5 × −1R → SD 1.5R&lt;br&gt;3 × +4R / 7 × −1R → SD 2.3R&lt;br&gt;1 × +14R / 9 × −1R → SD 4.5R&lt;br&gt;&lt;br&gt;&lt;b&gt;Fewer, bigger winners → same average, bumpier ride.&lt;/b&gt;&lt;br&gt;&lt;br&gt;More trades: the spread of the &lt;i&gt;total&lt;/i&gt; grows like √n (10 × SD after 100 trades), while the &lt;i&gt;average per trade&lt;/i&gt; settles down (Chance Events)." vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="v_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Common misconceptions" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="v_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;&#39;Same expectancy = same system.&#39;&lt;/b&gt; No: the ride decides whether you can stick with it and how much you can risk.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;Variance = bad.&#39;&lt;/b&gt; It counts big wins as much as big losses. In Wild, the +14R winner creates 90% of the variance. Variance measures bumpiness, not badness.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;Variance is the average distance.&#39;&lt;/b&gt; It is the average &lt;i&gt;squared&lt;/i&gt; distance. SD brings it back to R units." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="v_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="v_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="μ = the expectation (average)&lt;br&gt;string = x − μ&lt;br&gt;&lt;br&gt;&lt;b&gt;Var(X) = E[(X − μ)²]&lt;/b&gt; (the average square)&lt;br&gt;&lt;b&gt;SD = √Var(X)&lt;/b&gt; (its side, in R)&lt;br&gt;&lt;br&gt;Wild: (1 × 13.5² + 9 × 1.5²) ÷ 10&lt;br&gt;= (182.25 + 20.25) ÷ 10 = 20.25 → SD = 4.5R&lt;br&gt;&lt;br&gt;Over n trades: SD of the total = SD × √n&lt;br&gt;Van Tharp&#39;s SQN ≈ √n × expectancy ÷ SD (higher = smoother edge)" vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="v_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="v_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; two 10-trade strips with the same +5R total and very different shapes.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; strings to the average line, then strings turned into squares.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; 100-trade ranges, longest losing streaks, and the chance of still losing.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; same edge with different SDs, edge per unit of bumpiness, and the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="v_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="v_n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="The average says where you&#39;ll end up. The variance says whether you&#39;ll survive the trip." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>