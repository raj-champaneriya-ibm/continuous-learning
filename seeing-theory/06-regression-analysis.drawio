                </mxCell>
                <mxCell id="cr_ml4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontStyle=1;fontColor=#B71C1C;" value="−0.85" vertex="1">
                    <mxGeometry height="28" width="64" x="1088" y="223" as="geometry"/>
                </mxCell>
                <mxCell id="cr_ml5" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontStyle=1;fontColor=#E65100;" value="U-shape: ≈ 0" vertex="1">
                    <mxGeometry height="28" width="64" x="1158" y="223" as="geometry"/>
                </mxCell>
                <mxCell id="cr_t3a" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" value="The U-shape is a perfect pattern, yet r ≈ 0: correlation only sees straight lines." vertex="1">
                    <mxGeometry height="32" width="340" x="880" y="254" as="geometry"/>
                </mxCell>
                <mxCell id="cr_sysT" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" value="Two systems traded half-and-half: combined swing" vertex="1">
                    <mxGeometry height="20" width="340" x="880" y="298" as="geometry"/>
                </mxCell>
                <mxCell id="cr_s1L" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" value="r = +1" vertex="1">
                    <mxGeometry height="20" width="120" x="880" y="324" as="geometry"/>
                </mxCell>
                <mxCell id="cr_s1B" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E57373;strokeColor=#B71C1C;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" value="100% (no help)" vertex="1">
                    <mxGeometry height="20" width="200" x="1005" y="324" as="geometry"/>
                </mxCell>
                <mxCell id="cr_s2L" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" value="r = +0.5" vertex="1">
                    <mxGeometry height="20" width="120" x="880" y="348" as="geometry"/>
                </mxCell>
                <mxCell id="cr_s2B" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" value="87%" vertex="1">
                    <mxGeometry height="20" width="173" x="1005" y="348" as="geometry"/>
                </mxCell>
                <mxCell id="cr_s3L" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" value="r = 0" vertex="1">
                    <mxGeometry height="20" width="120" x="880" y="372" as="geometry"/>
                </mxCell>
                <mxCell id="cr_s3B" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontColor=#1B5E20;fontSize=10;fontStyle=1;" value="71%" vertex="1">
                    <mxGeometry height="20" width="141" x="1005" y="372" as="geometry"/>
                </mxCell>
                <mxCell id="cr_s4L" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" value="r = −0.5" vertex="1">
                    <mxGeometry height="20" width="120" x="880" y="396" as="geometry"/>
                </mxCell>
                <mxCell id="cr_s4B" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#2E7D32;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" value="50%" vertex="1">
                    <mxGeometry height="20" width="100" x="1005" y="396" as="geometry"/>
                </mxCell>
                <mxCell id="cr_sysN" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" value="Both systems have the same edge and the same swing. Lower correlation keeps the edge but smooths the ride." vertex="1">
                    <mxGeometry height="34" width="340" x="880" y="422" as="geometry"/>
                </mxCell>
                <mxCell id="cr_t3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" value="Trend score vs R: r = +0.85, so r² ≈ 72% of the scatter in R lines up with the score." vertex="1">
                    <mxGeometry height="62" width="350" x="875" y="466" as="geometry"/>
                </mxCell>
                <mxCell id="cr_t3warn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="Correlation isn&#39;t causation. And correlations between systems often jump toward +1 in market stress, just when you need diversification most." vertex="1">
                    <mxGeometry height="165" width="350" x="875" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="cr_p4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6FBF4;strokeColor=#82b366;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="660" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="cr_h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="4 · INSIGHT" vertex="1">
                    <mxGeometry height="44" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="cr_i1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;" value="&lt;b&gt;Correlation r&lt;/b&gt; is a unit-free number from −1 to +1 for how tightly two things move together along a straight line." vertex="1">
                    <mxGeometry height="85" width="350" x="1295" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="cr_i2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Read r" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="237" as="geometry"/>
                </mxCell>
                <mxCell id="cr_rSg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="SIGN" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="265" as="geometry"/>
                </mxCell>
                <mxCell id="cr_rSgT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="+ rise together; − one rises as the other falls" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="265" as="geometry"/>
                </mxCell>
                <mxCell id="cr_rSz" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="SIZE" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="309" as="geometry"/>
                </mxCell>
                <mxCell id="cr_rSzT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Near ±1: tight. Near 0: no straight-line link" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="309" as="geometry"/>
                </mxCell>
                <mxCell id="cr_rR2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="r²" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="353" as="geometry"/>
                </mxCell>
                <mxCell id="cr_rR2T" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Share of the scatter the line explains (0.85² ≈ 72%)" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="353" as="geometry"/>
                </mxCell>
                <mxCell id="cr_i3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Not causation, not slope" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="402" as="geometry"/>
                </mxCell>
                <mxCell id="cr_i3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" value="r says how tight, not how steep, and never why. Slope = r × (spread of y ÷ spread of x)." vertex="1">
                    <mxGeometry height="48" width="350" x="1295" y="427" as="geometry"/>
                </mxCell>
                <mxCell id="cr_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#2E7D32;" value="Van Tharp-style: combine systems with low correlation to smooth the equity curve without giving up edge." vertex="1">
                    <mxGeometry height="58" width="350" x="1295" y="482" as="geometry"/>
                </mxCell>
                <mxCell id="cr_takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" value="Correlation tells you how tightly two things move together, not why, and not by how much." vertex="1">
                    <mxGeometry height="95" width="350" x="1295" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="cr_next" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#5B8C46;" value="Next concept: Analysis of variance" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="cr_e12" edge="1" parent="1" source="cr_p1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="cr_p2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cr_e23" edge="1" parent="1" source="cr_p2" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="cr_p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cr_e34" edge="1" parent="1" source="cr_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="cr_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cr_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Correlation (r)&lt;/b&gt; is a single number from −1 to +1 that measures how tightly two things move together along a straight line." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="The least-squares slope tells you how much R changes per point of trend score. But two journals can share the same slope while one hugs the line and the other scatters wildly.&lt;br&gt;&lt;br&gt;We also want a measure that doesn&#39;t depend on units (score points, R, dollars). Correlation standardizes both variables and asks: do they rise and fall together, and how consistently?" vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual mental model: rectangles from the center" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Draw a cross at the two averages. Each trade forms a rectangle with the center of the cross.&lt;br&gt;• Top-right or bottom-left (both above or both below average): &lt;b&gt;green&lt;/b&gt;, they agree&lt;br&gt;• Top-left or bottom-right: &lt;b&gt;red&lt;/b&gt;, they disagree&lt;br&gt;&lt;br&gt;&lt;b&gt;compare the green area with the red area&lt;/b&gt;. Here: 21.0 green vs 0.5 red, strongly positive. Rescaled so a perfect line scores ±1, that&#39;s r = +0.85." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: study hours and scores" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Hours studied vs test score for 4 students:&lt;br&gt;&lt;br&gt;(1, 60), (2, 70), (3, 80), (4, 90): every point on one line, &lt;b&gt;r = +1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Swap two scores: (1, 70), (2, 60), (3, 90), (4, 80): still rising, less tight, &lt;b&gt;r = +0.6&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reverse the original scores: &lt;b&gt;r = −1&lt;/b&gt;" vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Inside one system:&lt;/b&gt; trend score vs R has r = +0.85, so r² ≈ 72% of the scatter in R lines up with the score.&lt;br&gt;&lt;br&gt;&lt;b&gt;Between systems:&lt;/b&gt; two systems with the same edge and the same swing, traded half-and-half. Combined swing vs one system alone:&lt;br&gt;r = +1 → 100% · r = +0.5 → 87% · r = 0 → 71% · r = −0.5 → 50%&lt;br&gt;&lt;br&gt;Van Tharp-style improvement: the same expectancy with a smoother ride, by combining weakly correlated systems." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes when the cloud changes?" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Tighter cloud:&lt;/b&gt; r moves toward ±1.&lt;br&gt;&lt;b&gt;Steeper line, same tightness:&lt;/b&gt; r is unchanged.&lt;br&gt;&lt;b&gt;Change units&lt;/b&gt; (R → dollars): r is unchanged.&lt;br&gt;&lt;b&gt;Curved pattern&lt;/b&gt; (U-shape): r ≈ 0 despite a perfect relationship.&lt;br&gt;&lt;b&gt;One outlier:&lt;/b&gt; can push r up or down a lot in small samples.&lt;br&gt;&lt;b&gt;Lower correlation between systems:&lt;/b&gt; smoother combined equity, same edge." vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Misconception: &#39;correlation means causation&#39;" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;&#39;Correlation means causation.&#39;&lt;/b&gt; Ice-cream sales and drownings correlate because summer drives both. A high trend score and good R could both come from the market regime.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;r = 0 means unrelated.&#39;&lt;/b&gt; It only means no &lt;i&gt;straight-line&lt;/i&gt; link (see the U-shape).&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;High r means a big effect.&#39;&lt;/b&gt; r measures tightness, not steepness.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;Low correlation is permanent.&#39;&lt;/b&gt; Correlations between systems often rise in market stress." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;r = Σ(x − x̄)(y − ȳ) ÷ √[Σ(x − x̄)² × Σ(y − ȳ)²]&lt;/b&gt;&lt;br&gt;Here: 20.5 ÷ √(42 × 13.875) = 20.5 ÷ 24.1 ≈ 0.85&lt;br&gt;&lt;br&gt;&lt;b&gt;r² = 1 − (squared miss of the line ÷ squared miss of the flat average)&lt;/b&gt;&lt;br&gt;= 1 − 3.87 ÷ 13.88 ≈ 0.72&lt;br&gt;&lt;br&gt;Slope = r × SD(y) ÷ SD(x) = 0.85 × 0.57 ≈ 0.49&lt;br&gt;&lt;br&gt;Two systems with equal SD σ, half each:&lt;br&gt;combined SD = σ × √((1 + r) ÷ 2)" vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; two journals with the same slope but very different scatter.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; a cross at the averages; green (agree) and red (disagree) rectangles.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; scatter shapes from +1 to −1 plus a U-shape; how correlation between two systems changes the combined swing.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; sign, size, r²; not causation, not slope; the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="cr_n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="Correlation tells you how tightly two things move together, not why, and not by how much." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>