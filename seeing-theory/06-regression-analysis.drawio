                <mxCell id="cr_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#333333;" value="Correlation: how tightly two things move together" vertex="1">
                    <mxGeometry height="40" width="1640" x="20" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="cr_p1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#6c8ebf;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="660" width="380" x="20" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="cr_h1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" value="1 · OBSERVATION" vertex="1">
                    <mxGeometry height="44" width="380" x="20" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="cr_t1a" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" value="Two journals, same slope (+0.5R per score point)" vertex="1">
                    <mxGeometry height="24" width="354" x="33" y="135" as="geometry"/>
                </mxCell>
                <mxCell id="cr_boxA" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;" value="" vertex="1">
                    <mxGeometry height="120" width="160" x="40" y="165" as="geometry"/>
                </mxCell>
                <mxCell id="cr_boxB" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;" value="" vertex="1">
                    <mxGeometry height="120" width="160" x="220" y="165" as="geometry"/>
                </mxCell>
                <mxCell id="cr_lnA" edge="1" parent="1" style="endArrow=none;html=1;strokeColor=#2E7D32;strokeWidth=2;" value="">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="50" y="270" as="sourcePoint"/>
                        <mxPoint x="190" y="185" as="targetPoint"/>
