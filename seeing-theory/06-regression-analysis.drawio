                <mxCell id="o_l2B" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="6.3" vertex="1">
                    <mxGeometry height="26" width="88" x="1005" y="197" as="geometry"/>
                </mxCell>
                <mxCell id="o_l3L" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" value="&lt;b&gt;Least squares&lt;/b&gt; (slope 0.49)" vertex="1">
                    <mxGeometry height="26" width="125" x="878" y="229" as="geometry"/>
                </mxCell>
                <mxCell id="o_l3B" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#2E7D32;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="3.9" vertex="1">
                    <mxGeometry height="26" width="54" x="1005" y="229" as="geometry"/>
                </mxCell>
                <mxCell id="o_l4L" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" value="&lt;b&gt;Too steep&lt;/b&gt; (slope 1.0)" vertex="1">
                    <mxGeometry height="26" width="125" x="878" y="261" as="geometry"/>
                </mxCell>
                <mxCell id="o_l4B" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E57373;strokeColor=#B71C1C;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="14.9" vertex="1">
                    <mxGeometry height="26" width="208" x="1005" y="261" as="geometry"/>
                </mxCell>
                <mxCell id="o_lCap" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;" value="All four lines pass through the averages (score 4.5, +0.63R); only the tilt changes." vertex="1">
                    <mxGeometry height="32" width="340" x="880" y="293" as="geometry"/>
                </mxCell>
                <mxCell id="o_oT" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" value="Add one +8R trade (an outlier)" vertex="1">
                    <mxGeometry height="20" width="340" x="880" y="335" as="geometry"/>
                </mxCell>
                <mxCell id="o_o1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#B71C1C;" value="at score 2 → slope 0.49 → 0.09 (trend nearly erased)" vertex="1">
                    <mxGeometry height="22" width="340" x="880" y="357" as="geometry"/>
                </mxCell>
                <mxCell id="o_o2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#B71C1C;" value="at score 8 → slope 0.49 → 0.82 (trend exaggerated)" vertex="1">
                    <mxGeometry height="22" width="340" x="880" y="379" as="geometry"/>
                </mxCell>
                <mxCell id="o_oN" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" value="Squaring makes one big miss count like many small ones." vertex="1">
                    <mxGeometry height="22" width="340" x="880" y="403" as="geometry"/>
                </mxCell>
                <mxCell id="o_fT" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" value="Use it as a filter idea" vertex="1">
                    <mxGeometry height="20" width="340" x="880" y="435" as="geometry"/>
                </mxCell>
                <mxCell id="o_f1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2E7D32;" value="Line crosses 0R at score ≈ 3.2 → test &#39;only trade scores of 4 or more&#39;" vertex="1">
                    <mxGeometry height="36" width="340" x="880" y="457" as="geometry"/>
                </mxCell>
                <mxCell id="o_t3a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" value="Best line: total squared miss 3.9, vs 13.9 for &#39;just use the average&#39;. The trend accounts for about 72% of the scatter." vertex="1">
                    <mxGeometry height="68" width="350" x="875" y="503" as="geometry"/>
                </mxCell>
                <mxCell id="o_t3warn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="8 trades is a tiny sample, and the line is an average trend, not a promise. Don&#39;t extend it beyond scores you&#39;ve seen, and check outliers before trusting the slope." vertex="1">
                    <mxGeometry height="122" width="350" x="875" y="583" as="geometry"/>
                </mxCell>
                <mxCell id="o_p4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6FBF4;strokeColor=#82b366;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="660" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="o_h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="4 · INSIGHT" vertex="1">
                    <mxGeometry height="44" width="380" x="1280" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="o_i1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=13;" value="&lt;b&gt;Least squares&lt;/b&gt; picks the straight line with the smallest total of squared vertical misses: the best average trend through the points." vertex="1">
                    <mxGeometry height="85" width="350" x="1295" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="o_i2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Read the line" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="237" as="geometry"/>
                </mxCell>
                <mxCell id="o_rSl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="SLOPE" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="265" as="geometry"/>
                </mxCell>
                <mxCell id="o_rSlT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="+0.49R for each extra point of trend score" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="265" as="geometry"/>
                </mxCell>
                <mxCell id="o_rBe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=10;fontStyle=1;" value="BREAKEVEN" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="309" as="geometry"/>
                </mxCell>
                <mxCell id="o_rBeT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Crosses 0R at a score of about 3.2: a filter candidate" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="309" as="geometry"/>
                </mxCell>
                <mxCell id="o_rMs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="MISSES" vertex="1">
                    <mxGeometry height="38" width="90" x="1295" y="353" as="geometry"/>
                </mxCell>
                <mxCell id="o_rMsT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" value="Leftover scatter (residuals): up to about ±0.9R per trade here" vertex="1">
                    <mxGeometry height="38" width="253" x="1392" y="353" as="geometry"/>
                </mxCell>
                <mxCell id="o_i3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="It always passes through the averages" vertex="1">
                    <mxGeometry height="22" width="350" x="1295" y="402" as="geometry"/>
                </mxCell>
                <mxCell id="o_i3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" value="The line goes through (average score 4.5, average R +0.63R). Least squares only chooses the tilt around that point." vertex="1">
                    <mxGeometry height="48" width="350" x="1295" y="427" as="geometry"/>
                </mxCell>
                <mxCell id="o_i4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=3;fontColor=#2E7D32;" value="Van Tharp-style improvement: a slope suggests a filter (trade only scores of 4+). Then test it on new trades." vertex="1">
                    <mxGeometry height="58" width="350" x="1295" y="482" as="geometry"/>
                </mxCell>
                <mxCell id="o_takeaway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" value="Square every miss and pick the line with the least total: that&#39;s the trend your trades actually show." vertex="1">
                    <mxGeometry height="95" width="350" x="1295" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="o_next" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#5B8C46;" value="Next concept: Correlation" vertex="1">
                    <mxGeometry height="50" width="350" x="1295" y="655" as="geometry"/>
                </mxCell>
                <mxCell id="o_e12" edge="1" parent="1" source="o_p1" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="o_p2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="o_e23" edge="1" parent="1" source="o_p2" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="o_p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="o_e34" edge="1" parent="1" source="o_p3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="o_p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="o_notesTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" value="LESSON NOTES: the full explanation, for future reference" vertex="1">
                    <mxGeometry height="34" width="1640" x="20" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="o_n1h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="1 · Core idea" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="o_n1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Least squares&lt;/b&gt; draws the one straight line through a cloud of points that makes the total of squared vertical misses as small as possible.&lt;br&gt;&lt;br&gt;It is the best average trend: how much y changes, on average, when x goes up by one." vertex="1">
                    <mxGeometry height="320" width="320" x="20" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="o_n2h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="2 · Intuition" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="o_n2b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="You suspect stronger trends give better trades. The scatter plot roughly agrees, but every eye draws a slightly different line.&lt;br&gt;&lt;br&gt;Least squares replaces eyeballing with a rule: measure how far each point misses the line, square those misses, add them up, and choose the line with the smallest total.&lt;br&gt;&lt;br&gt;Squaring keeps misses positive and punishes big misses more than small ones." vertex="1">
                    <mxGeometry height="320" width="320" x="350" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="o_n3h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="3 · Visual mental model: sticks and squares" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="o_n3b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Hang a vertical stick from each point to the line. Turn each stick into a square.&lt;br&gt;&lt;br&gt;&lt;b&gt;tilt and slide the line until the total square area is as small as it can be&lt;/b&gt;. That position is the least-squares line.&lt;br&gt;&lt;br&gt;It&#39;s the Variance tab&#39;s &#39;strings into squares&#39;, with a sloping line instead of a flat average." vertex="1">
                    <mxGeometry height="320" width="320" x="680" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="o_n4h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="4 · Simple example: three points" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="o_n4b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Points: (1, 1), (2, 2), (3, 6).&lt;br&gt;&lt;br&gt;Averages: x̄ = 2, ȳ = 3, so the line must pass through (2, 3).&lt;br&gt;Slope = [(−1)(−2) + (0)(−1) + (1)(3)] ÷ [1 + 0 + 1] = 5 ÷ 2 = 2.5&lt;br&gt;Line: y = −2 + 2.5x&lt;br&gt;&lt;br&gt;Misses: +0.5, −1, +0.5&lt;br&gt;Squares: 0.25 + 1 + 0.25 = 1.5&lt;br&gt;No other straight line does better." vertex="1">
                    <mxGeometry height="320" width="320" x="1010" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="o_n5h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="5 · Trading analogy" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="805" as="geometry"/>
                </mxCell>
                <mxCell id="o_n5b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="8 trades: trend score at entry vs R.&lt;br&gt;Least-squares line: &lt;b&gt;R ≈ −1.57 + 0.49 × score&lt;/b&gt;&lt;br&gt;• each extra point of score adds about +0.5R on average&lt;br&gt;• the line crosses 0R at a score of about 3.2&lt;br&gt;• total squared miss 3.9, vs 13.9 for &#39;every trade is the average +0.63R&#39;&lt;br&gt;&lt;br&gt;Van Tharp-style improvement: the slope suggests a filter (only take scores of 4 or more). Treat it as a hypothesis and test it on new trades; 8 trades is a tiny sample." vertex="1">
                    <mxGeometry height="320" width="320" x="1340" y="837" as="geometry"/>
                </mxCell>
                <mxCell id="o_n6h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="6 · What changes when you move the line?" vertex="1">
                    <mxGeometry height="32" width="320" x="20" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="o_n6b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;Tilt the line&lt;/b&gt; (total squared miss): flat 13.9 · too shallow 6.3 · least squares 3.9 · too steep 14.9.&lt;br&gt;&lt;br&gt;&lt;b&gt;Add one +8R outlier:&lt;/b&gt; at score 2 the slope drops from 0.49 to 0.09; at score 8 it jumps to 0.82. One trade can erase or exaggerate the trend.&lt;br&gt;&lt;br&gt;&lt;b&gt;More trades:&lt;/b&gt; the slope estimate steadies; its wobble shrinks like 1/√n." vertex="1">
                    <mxGeometry height="330" width="320" x="20" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="o_n7h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="7 · Misconception: &#39;the line predicts each trade&#39;" vertex="1">
                    <mxGeometry height="32" width="320" x="350" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="o_n7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="&lt;b&gt;&#39;The line predicts each trade.&#39;&lt;/b&gt; It predicts the average. Individual trades still miss by up to about 0.9R here.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;A slope proves the score causes better trades.&#39;&lt;/b&gt; It shows they move together in this sample. Something else could drive both.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;Extend the line anywhere.&#39;&lt;/b&gt; A score of 20 was never seen; the line says nothing reliable there.&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;Outliers don&#39;t matter.&#39;&lt;/b&gt; Squaring makes them matter a lot." vertex="1">
                    <mxGeometry height="330" width="320" x="350" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="o_n8h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="8 · Minimal mathematics" vertex="1">
                    <mxGeometry height="32" width="320" x="680" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="o_n8b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Line: ŷ = a + b × x&lt;br&gt;Choose a and b to minimize &lt;b&gt;Σ (y − ŷ)²&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;b = Σ(x − x̄)(y − ȳ) ÷ Σ(x − x̄)²&lt;/b&gt;&lt;br&gt;&lt;b&gt;a = ȳ − b × x̄&lt;/b&gt;&lt;br&gt;&lt;br&gt;Here: b = 20.5 ÷ 42 ≈ 0.49&lt;br&gt;a = 0.625 − 0.49 × 4.5 ≈ −1.57&lt;br&gt;&lt;br&gt;The line always passes through (x̄, ȳ) = (4.5, +0.63R).&lt;br&gt;Residual = y − ŷ; the residuals add to zero." vertex="1">
                    <mxGeometry height="330" width="320" x="680" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="o_n9h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#B0B0B0;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="9 · How to read the diagram above" vertex="1">
                    <mxGeometry height="32" width="320" x="1010" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="o_n9b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacing=10;fontSize=13;" value="Left to right:&lt;br&gt;&lt;br&gt;&lt;b&gt;1 Observation:&lt;/b&gt; 8 trades with a trend score and an R; everyone eyeballs a different line.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Intuition:&lt;/b&gt; scatter plot, the best line, sticks turned into squares.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Experiment:&lt;/b&gt; total squared miss for four lines; one outlier tilts the line; a filter idea.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Insight:&lt;/b&gt; slope, breakeven, misses; the line passes through the averages; the takeaway." vertex="1">
                    <mxGeometry height="330" width="320" x="1010" y="1204" as="geometry"/>
                </mxCell>
                <mxCell id="o_n10h" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;align=left;spacingLeft=10;fontSize=14;fontStyle=1;" value="10 · Takeaway" vertex="1">
                    <mxGeometry height="32" width="320" x="1340" y="1172" as="geometry"/>
                </mxCell>
                <mxCell id="o_n10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=center;verticalAlign=middle;spacing=16;fontSize=17;fontStyle=1;fontColor=#1B5E20;" value="Square every miss and pick the line with the least total: that&#39;s the trend your trades actually show." vertex="1">
                    <mxGeometry height="330" width="320" x="1340" y="1204" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="correlation" name="02 Correlation">
        <mxGraphModel dx="566" dy="477" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1560" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
